#!/usr/bin/env bash
# Submit any Xcode iOS app to App Store Connect from the command line.
set -euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: app-store-submit <app-project-path> [--create-app] [--submit] [--set-free-price] [--release] [--no-tests] [--dry-run]

This internal helper is configured by deploy-app, which creates the app
project's .app-store-submit.env. Store metadata belongs at store-metadata/en-US
by default; screenshots and previews default to screenshots/{iphone,ipad} and
previews. No App Store credentials are kept in the project or this script.
EOF
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac
[[ $# -ge 1 ]] || { usage >&2; exit 2; }
PROJECT_DIR="$(cd "$1" 2>/dev/null && pwd)" || { printf 'Project directory not found: %s\n' "$1" >&2; exit 2; }
shift

create_app=0
submit=0
set_free_price=0
release=0
dry_run=0
no_tests=0
for argument in "$@"; do
  case "$argument" in
    --create-app) create_app=1 ;;
    --submit) submit=1 ;;
    --set-free-price) set_free_price=1 ;;
    --release) release=1 ;;
    --no-tests) no_tests=1 ;;
    --dry-run) dry_run=1 ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

CONFIG_FILE="$PROJECT_DIR/.app-store-submit.env"
[[ -f "$CONFIG_FILE" ]] || { printf 'Missing %s. Run deploy-app first: /Users/asgarov1/Projects/swift/scripts/deploy-app/deploy-app %q\n' "$CONFIG_FILE" "$PROJECT_DIR" >&2; exit 1; }
cd "$PROJECT_DIR"
set -a
# shellcheck disable=SC1090
source "$CONFIG_FILE"
set +a

# This helper is deliberately API-key-only. Do not let a legacy project
# configuration turn a deployment into an Apple ID web login: repeated web
# session attempts can trigger Apple's account-lock protection.
unset APPLE_ID FASTLANE_SESSION FASTLANE_PASSWORD FASTLANE_USER

relative_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PROJECT_DIR" "$1" ;;
  esac
}

required=(APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL BUILD_NUMBER COPYRIGHT CONTENT_RIGHTS_DECLARATION PRICE_TIER AVAILABLE_IN_ALL_TERRITORIES AGE_RATING_CONFIG_PATH)
for variable in "${required[@]}"; do
  [[ -n "${!variable:-}" ]] || { printf 'Missing %s in %s\n' "$variable" "$CONFIG_FILE" >&2; exit 1; }
done
METADATA_PATH="$(relative_path "${METADATA_PATH:-store-metadata}")"
PREVIEW_PATH="$(relative_path "${PREVIEW_PATH:-previews}")"
ASC_KEY_FILE="$(relative_path "$ASC_KEY_FILE")"
XCODEPROJ="$(relative_path "$XCODEPROJ")"
export METADATA_PATH ASC_KEY_FILE XCODEPROJ
AGE_RATING_CONFIG_PATH="$(relative_path "$AGE_RATING_CONFIG_PATH")"
export AGE_RATING_CONFIG_PATH
[[ -d "$XCODEPROJ" ]] || { printf 'Xcode project not found: %s\n' "$XCODEPROJ" >&2; exit 1; }
[[ -f "$ASC_KEY_FILE" ]] || { printf 'API key not found: %s\n' "$ASC_KEY_FILE" >&2; exit 1; }
[[ -d "$METADATA_PATH/en-US" ]] || { printf 'Metadata directory not found: %s/en-US\n' "$METADATA_PATH" >&2; exit 1; }
[[ -f "$AGE_RATING_CONFIG_PATH" ]] || { printf 'Age-rating configuration not found: %s\n' "$AGE_RATING_CONFIG_PATH" >&2; exit 1; }
case "$AVAILABLE_IN_ALL_TERRITORIES" in 0|1) ;; *) printf 'AVAILABLE_IN_ALL_TERRITORIES must be 0 or 1\n' >&2; exit 1 ;; esac
case "${SKIP_SCREENSHOTS_IF_UNCHANGED:-1}" in 0|1) ;; *) printf 'SKIP_SCREENSHOTS_IF_UNCHANGED must be 0 or 1\n' >&2; exit 1 ;; esac
[[ "$PRICE_TIER" =~ ^[0-9]+$ ]] || { printf 'PRICE_TIER must be a non-negative integer\n' >&2; exit 1; }
if [[ "${IAP_CREATE_DEFAULTS:-1}" == 1 ]]; then
  for variable in IAP_MONTHLY_PRODUCT_ID IAP_QUARTERLY_PRODUCT_ID IAP_LIFETIME_PRODUCT_ID; do
    [[ "${!variable:-}" =~ ^[A-Za-z0-9_.]+$ ]] || { printf '%s must contain only ASCII letters, digits, underscores, and periods\n' "$variable" >&2; exit 1; }
  done
fi

ASSET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/app-store-assets.XXXXXX")"
PREVIEW_ASSET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/app-store-previews.XXXXXX")"
FASTFILE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/app-store-fastlane.XXXXXX")"
cleanup() { rm -rf "$ASSET_DIR" "$PREVIEW_ASSET_DIR" "$FASTFILE_DIR"; }
trap cleanup EXIT
mkdir -p "$ASSET_DIR/en-US"
mkdir -p "$PREVIEW_ASSET_DIR/en-US"

screenshot_dimensions() {
  local width height
  width="$(sips -g pixelWidth "$1" 2>/dev/null | awk '/pixelWidth:/{print $2}')"
  height="$(sips -g pixelHeight "$1" 2>/dev/null | awk '/pixelHeight:/{print $2}')"
  [[ -n "$width" && -n "$height" ]] || { printf 'Could not read screenshot dimensions: %s\n' "$1" >&2; exit 1; }
  printf '%sx%s\n' "$width" "$height"
}

valid_screenshot_dimensions() {
  local device="$1" dimensions="$2"
  case "$device:$dimensions" in
    # Highest App Store Connect screenshot families: iPhone 6.9-inch and iPad 13-inch.
    iphone:1260x2736|iphone:2736x1260|iphone:1290x2796|iphone:2796x1290|iphone:1320x2868|iphone:2868x1320|ipad:2064x2752|ipad:2752x2064|ipad:2048x2732|ipad:2732x2048) return 0 ;;
    *) return 1 ;;
  esac
}

screenshot_count=0
iphone_screenshot_count=0
ipad_screenshot_count=0
for source_dir in ${SCREENSHOT_PATHS:-screenshots/iphone screenshots/ipad}; do
  source_dir="$(relative_path "$source_dir")"
  [[ -d "$source_dir" ]] || continue
  device_family="$(basename "$source_dir")"
  case "$device_family" in
    iphone|ipad) ;;
    *) printf 'Screenshot directory must end in iphone or ipad: %s\n' "$source_dir" >&2; exit 1 ;;
  esac
  for screenshot in "$source_dir"/*.png "$source_dir"/*.jpg "$source_dir"/*.jpeg; do
    [[ -f "$screenshot" ]] || continue
    dimensions="$(screenshot_dimensions "$screenshot")"
    valid_screenshot_dimensions "$device_family" "$dimensions" || { printf 'Screenshot must use the highest %s App Store size; got %s: %s\n' "$device_family" "$dimensions" "$screenshot" >&2; exit 1; }
    [[ "$(sips -g hasAlpha "$screenshot" 2>/dev/null | awk '/hasAlpha:/{print $2}')" != "yes" ]] || { printf 'Screenshots cannot contain transparency: %s\n' "$screenshot" >&2; exit 1; }
    screenshot_count=$((screenshot_count + 1))
    if [[ "$device_family" == "iphone" ]]; then
      iphone_screenshot_count=$((iphone_screenshot_count + 1))
    else
      ipad_screenshot_count=$((ipad_screenshot_count + 1))
    fi
    cp "$screenshot" "$ASSET_DIR/en-US/${device_family}-$(printf '%02d' "$screenshot_count")-$(basename "$screenshot")"
  done
done
[[ "$screenshot_count" -gt 0 ]] || { printf 'No screenshots found. Check SCREENSHOT_PATHS.\n' >&2; exit 1; }
[[ "$iphone_screenshot_count" -le 10 && "$ipad_screenshot_count" -le 10 ]] || { printf 'App Store Connect permits at most 10 screenshots per device family.\n' >&2; exit 1; }

preview_count=0
iphone_preview_count=0
ipad_preview_count=0
for preview in "$PREVIEW_PATH"/*.mp4 "$PREVIEW_PATH"/*.mov "$PREVIEW_PATH"/*.m4v; do
  [[ -f "$preview" ]] || continue
  [[ -x "$(command -v ffprobe)" ]] || { printf 'ffprobe is required to validate App Preview videos.\n' >&2; exit 1; }
  preview_name="$(basename "$preview")"
  preview_name_lower="$(printf '%s' "$preview_name" | tr '[:upper:]' '[:lower:]')"
  case "$preview_name_lower" in
    *iphone_67*) preview_family=iphone; expected_preview_dimensions='886x1920|1920x886'; iphone_preview_count=$((iphone_preview_count + 1)) ;;
    *ipad_pro_3gen_129*) preview_family=ipad; expected_preview_dimensions='1200x1600|1600x1200'; ipad_preview_count=$((ipad_preview_count + 1)) ;;
    *) printf 'App Preview filename must include IPHONE_67 or IPAD_PRO_3GEN_129: %s\n' "$preview" >&2; exit 1 ;;
  esac
  preview_width="$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_height="$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_fps="$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_codec="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_dimensions="${preview_width}x${preview_height}"
  [[ "$preview_dimensions" =~ ^($expected_preview_dimensions)$ ]] || { printf 'App Preview dimensions do not match the highest %s family: %s\n' "$preview_family" "$preview" >&2; exit 1; }
  awk -v duration="$preview_duration" 'BEGIN { exit !(duration >= 15 && duration <= 30) }' || { printf 'App Preview must be 15-30 seconds: %s\n' "$preview" >&2; exit 1; }
  awk -v fps="$preview_fps" 'BEGIN { split(fps, rate, "/"); exit !(rate[2] > 0 && rate[1] / rate[2] <= 30) }' || { printf 'App Preview frame rate must not exceed 30 fps: %s\n' "$preview" >&2; exit 1; }
  [[ "$preview_codec" == "h264" || "$preview_codec" == "prores" ]] || { printf 'App Preview must use H.264 or ProRes: %s\n' "$preview" >&2; exit 1; }
  [[ "$preview_codec" != "prores" || "$preview_name_lower" == *.mov ]] || { printf 'ProRes App Previews must use a .mov extension: %s\n' "$preview" >&2; exit 1; }
  [[ "$(stat -f %z "$preview")" -le 524288000 ]] || { printf 'App Preview exceeds 500 MB: %s\n' "$preview" >&2; exit 1; }
  preview_count=$((preview_count + 1))
  cp "$preview" "$PREVIEW_ASSET_DIR/en-US/$preview_name"
done
[[ "$iphone_preview_count" -le 3 && "$ipad_preview_count" -le 3 ]] || { printf 'App Store Connect permits at most 3 App Previews per device family.\n' >&2; exit 1; }
export SCREENSHOTS_PATH="$ASSET_DIR"
[[ "$preview_count" -gt 0 ]] && export APP_PREVIEWS_PATH="$PREVIEW_ASSET_DIR"
export AUTOMATIC_RELEASE="$release"
export SKIP_SCREENSHOTS_IF_UNCHANGED="${SKIP_SCREENSHOTS_IF_UNCHANGED:-1}"
[[ "$no_tests" == "1" ]] && export RUN_TESTS=0

if [[ "$dry_run" == "1" ]]; then
  printf 'Validated %s and staged assets. No Apple service was contacted.\n' "$PROJECT_DIR"
  exit 0
fi

mkdir -p "$FASTFILE_DIR/fastlane"
cat > "$FASTFILE_DIR/fastlane/Fastfile" <<'RUBY'
default_platform(:ios)
require "digest/md5"
require "json"
require "net/http"
require "uri"

platform :ios do
  def asc_request(api_key, method, path, body: nil)
    token = Spaceship::ConnectAPI::Token.create(**api_key).text
    uri = URI.join("https://api.appstoreconnect.apple.com", path)
    unless uri.scheme == "https" && uri.host == "api.appstoreconnect.apple.com" && uri.port == 443
      UI.user_error!("Unexpected App Store Connect URL: #{path}")
    end
    request_class = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }.fetch(method)
    request = request_class.new(uri)
    request["Authorization"] = "Bearer #{token}"
    request["Content-Type"] = "application/json" if body
    request.body = JSON.generate(body) if body
    response = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(request) }
    unless response.is_a?(Net::HTTPSuccess)
      begin
        error_response = JSON.parse(response.body)
      rescue JSON::ParserError
        error_response = {}
      end
      if @allow_unsupported_iap_locale && response&.code == "409" &&
          error_response.fetch("errors", []).any? { |error| error["code"] == "ENTITY_ERROR.SUBSCRIPTION_GROUP_LOCALIZATION_UNSUPPORTED_LOCALE_CODE" || error["code"] == "ENTITY_ERROR.SUBSCRIPTION_LOCALIZATION_UNSUPPORTED_LOCALE_CODE" }
        locale = body.dig(:data, :attributes, :locale)
        UI.important("App Store Connect does not support #{locale} for this in-app-purchase localization; skipped it while preserving the app's listing localization.")
        return { "data" => nil, "skippedUnsupportedLocale" => true }
      end
      UI.user_error!("App Store Connect #{method.to_s.upcase} #{path} failed (#{response.code}): #{response.body}")
    end
    response.body.to_s.empty? ? {} : JSON.parse(response.body)
  end

  def app_store_api_key
    app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_filepath: ENV.fetch("ASC_KEY_FILE"), duration: 1_200)
  end

  def asc_collection(api_key, path)
    resources = []
    while path
      response = asc_request(api_key, :get, path)
      resources.concat(response.fetch("data"))
      path = response.dig("links", "next")
    end
    resources
  end

  def with_unsupported_iap_locale_allowed
    previous = @allow_unsupported_iap_locale
    @allow_unsupported_iap_locale = true
    yield
  ensure
    @allow_unsupported_iap_locale = previous
  end

  def asc_resource_with_product_id(api_key, path, product_id)
    asc_collection(api_key, path).find { |resource| resource.dig("attributes", "productId") == product_id }
  end

  def asc_price_point(api_key, path, price)
    wanted_price = format("%.2f", price.to_f)
    point = asc_collection(api_key, path).find do |resource|
      format("%.2f", resource.dig("attributes", "customerPrice").to_f) == wanted_price
    end
    UI.user_error!("Apple returned no USA price point for $#{wanted_price} at #{path}") unless point
    point
  end

  def create_in_app_purchase_price_schedule(api_key, product_id:, price:, price_points_path:)
    return if price.to_s.empty?

    price_point = asc_price_point(api_key, price_points_path, price)
    # Inline resource IDs must include both delimiters in `${local-id}`.
    # One inline price needs only a request-local token, as in Apple's example.
    local_price_id = "${price1}"
    schedule = {
      data: {
        type: "inAppPurchasePriceSchedules",
        relationships: {
          inAppPurchase: { data: { type: "inAppPurchases", id: product_id } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "inAppPurchasePrices", id: local_price_id }] }
        }
      },
      included: [{
        id: local_price_id,
        type: "inAppPurchasePrices",
        attributes: { startDate: nil, endDate: nil },
        relationships: {
          # V2 is part of the relationship name, not the resource type.
          inAppPurchaseV2: { data: { type: "inAppPurchases", id: product_id } },
          inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: price_point.fetch("id") } }
        }
      }]
    }
    asc_request(api_key, :post, "/v1/inAppPurchasePriceSchedules", body: schedule)
  end

  def create_subscription_price(api_key, subscription_id:, price:, price_points_path:, plan_type:)
    price_point = asc_price_point(api_key, price_points_path, price)
    asc_request(api_key, :post, "/v1/subscriptionPrices", body: {
      data: {
        type: "subscriptionPrices",
        attributes: { startDate: nil, planType: plan_type },
        relationships: {
          subscription: { data: { type: "subscriptions", id: subscription_id } },
          subscriptionPricePoint: { data: { type: "subscriptionPricePoints", id: price_point.fetch("id") } }
        }
      }
    })
  end

  # A product can exist even if a prior run stopped while its first price was
  # being configured. Reconcile prices independently without overwriting a
  # price that was already chosen in App Store Connect.
  def subscription_has_price?(api_key, subscription_id, plan_type)
    asc_collection(api_key, "/v1/subscriptions/#{subscription_id}/prices?filter[territory]=USA&filter[planType]=#{plan_type}&limit=200").any?
  end

  def ensure_subscription_plan_availability(api_key, subscription_id, plan_type)
    plans = asc_collection(api_key, "/v1/subscriptions/#{subscription_id}/planAvailabilities?limit=200")
    plan = plans.find { |item| item.dig("attributes", "planType") == plan_type }
    if plan
      territories = asc_collection(api_key, "/v1/subscriptionPlanAvailabilities/#{plan.fetch("id")}/availableTerritories?limit=200")
      unless territories.any? { |territory| territory.fetch("id") == "USA" }
        UI.user_error!("Subscription #{subscription_id} has an existing #{plan_type} plan without USA availability. Enable USA in App Store Connect before configuring its USA price.")
      end
      return
    end

    # Apple requires plan availability before prices. Keep the initial offering
    # aligned with the USA-only price configured below; preserve existing plans.
    asc_request(api_key, :post, "/v1/subscriptionPlanAvailabilities", body: {
      data: {
        type: "subscriptionPlanAvailabilities",
        attributes: { planType: plan_type, availableInNewTerritories: false },
        relationships: {
          subscription: { data: { type: "subscriptions", id: subscription_id } },
          availableTerritories: { data: [{ type: "territories", id: "USA" }] }
        }
      }
    })
  end

  def ensure_subscription_price(api_key, subscription_id:, price:)
    # `MONTHLY` is Apple’s optional monthly billing for a 12-month commitment,
    # not a standard one-month subscription. It is unavailable in USA (and
    # Singapore), whereas normal auto-renewable subscriptions of any period
    # use the upfront plan.
    plan_type = "UPFRONT"
    return if subscription_has_price?(api_key, subscription_id, plan_type)

    ensure_subscription_plan_availability(api_key, subscription_id, plan_type)
    create_subscription_price(
      api_key,
      subscription_id: subscription_id,
      price: price,
      # The same dollar amount has distinct point IDs for Apple's optional
      # 12-month monthly-commitment plan and the normal upfront plan. Filter
      # before selecting, or Apple rejects a point from the other plan type.
      price_points_path: "/v1/subscriptions/#{subscription_id}/pricePoints?filter[territory]=USA&filter[planType]=#{plan_type}&limit=200",
      plan_type: plan_type
    )
    UI.success("Configured the USA price for subscription #{subscription_id}.")
  end

  def in_app_purchase_has_price_schedule?(api_key, product_id)
    response = asc_request(api_key, :get, "/v2/inAppPurchases/#{product_id}/relationships/iapPriceSchedule")
    !response.fetch("data", nil).nil?
  end

  def ensure_in_app_purchase_price_schedule(api_key, product_id:, price:)
    return if price.to_s.empty? || in_app_purchase_has_price_schedule?(api_key, product_id)

    create_in_app_purchase_price_schedule(
      api_key,
      product_id: product_id,
      price: price,
      price_points_path: "/v2/inAppPurchases/#{product_id}/pricePoints?filter[territory]=USA&limit=200"
    )
    UI.success("Configured the USA price for in-app purchase #{product_id}.")
  end

  def sync_product_localizations(api_key, product, subscription:)
    source = File.join(ENV.fetch("METADATA_PATH"), "localizations.json")
    return unless File.file?(source)

    product_id = product.dig("attributes", "productId")
    entries = JSON.parse(File.read(source)).map do |locale, values|
      text = values.fetch("subscriptions", {})[product_id]
      next unless text
      unless text.is_a?(Hash) && %w[displayName description].all? { |key| text[key].is_a?(String) && !text[key].strip.empty? }
        UI.user_error!("Invalid product localization for #{product_id} (#{locale}) in #{source}")
      end
      if text.fetch("displayName").length > 35
        UI.user_error!("Product displayName for #{product_id} (#{locale}) in #{source} is #{text.fetch('displayName').length} characters; maximum is 35: #{text.fetch('displayName').inspect}")
      end
      [locale, { name: text.fetch("displayName"), description: text.fetch("description") }]
    end.compact
    return if entries.empty?

    # The v1 localization API remains supported for existing integrations and
    # avoids creating review versions as a side effect of this setup flow.
    type = subscription ? "subscriptionLocalizations" : "inAppPurchaseLocalizations"
    parent_path = subscription ? "/v1/subscriptions" : "/v2/inAppPurchases"
    relationship = subscription ? :subscription : :inAppPurchaseV2
    parent_type = subscription ? "subscriptions" : "inAppPurchases"
    existing = asc_collection(api_key, "#{parent_path}/#{product.fetch("id")}/#{type}?limit=200")
    entries.each do |locale, attributes|
      localization = existing.find { |item| item.dig("attributes", "locale") == locale }
      if localization
        next if attributes.all? { |key, value| localization.dig("attributes", key.to_s) == value }
        asc_request(api_key, :patch, "/v1/#{type}/#{localization.fetch("id")}", body: {
          data: { type: type, id: localization.fetch("id"), attributes: attributes }
        })
      else
        with_unsupported_iap_locale_allowed { asc_request(api_key, :post, "/v1/#{type}", body: {
          data: {
            type: type, attributes: attributes.merge(locale: locale),
            relationships: { relationship => { data: { type: parent_type, id: product.fetch("id") } } }
          }
        }) }
      end
    end
    UI.success("Synchronized product localizations for #{product_id}.")
  end

  def sync_subscription_group_localizations(api_key, group)
    source = File.join(ENV.fetch("METADATA_PATH"), "localizations.json")
    return unless File.file?(source)

    entries = JSON.parse(File.read(source)).map do |locale, values|
      explicit = values.key?("subscriptionGroup")
      text = explicit ? values["subscriptionGroup"] : { "displayName" => values.dig("appInformation", "name") }
      unless text.is_a?(Hash) && text["displayName"].is_a?(String) && !text["displayName"].strip.empty? && text["displayName"].length <= 75
        UI.user_error!("Invalid subscription group displayName for #{locale} in #{source} (1–75 characters required)")
      end
      attributes = { name: text.fetch("displayName") }
      if text.key?("customAppName")
        custom_name = text["customAppName"]
        unless custom_name.nil? || (custom_name.is_a?(String) && !custom_name.strip.empty? && custom_name.length <= 30)
          UI.user_error!("Invalid subscription group customAppName for #{locale} in #{source} (1–30 characters or null required)")
        end
        attributes[:customAppName] = custom_name
      end
      [locale, attributes, explicit]
    end
    return if entries.empty?

    type = "subscriptionGroupLocalizations"
    existing = asc_collection(api_key, "/v1/subscriptionGroups/#{group.fetch("id")}/#{type}?limit=200")
    entries.each do |locale, attributes, explicit|
      localization = existing.find { |item| item.dig("attributes", "locale") == locale }
      if localization
        # Only explicitly configured group text is authoritative. A localized
        # app-name default fills gaps without replacing an editorial choice.
        next unless explicit
        next if attributes.all? { |key, value| localization.dig("attributes", key.to_s) == value }
        asc_request(api_key, :patch, "/v1/#{type}/#{localization.fetch("id")}", body: {
          data: { type: type, id: localization.fetch("id"), attributes: attributes }
        })
      else
        with_unsupported_iap_locale_allowed { asc_request(api_key, :post, "/v1/#{type}", body: {
          data: {
            type: type, attributes: attributes.merge(locale: locale),
            relationships: { subscriptionGroup: { data: { type: "subscriptionGroups", id: group.fetch("id") } } }
          }
        }) }
      end
    end
    UI.success("Synchronized subscription group localizations for #{group.fetch("id")}.")
  end

  def ensure_default_products(api_key, app)
    return unless ENV.fetch("IAP_CREATE_DEFAULTS", "1") == "1"

    source = File.join(ENV.fetch("METADATA_PATH"), "localizations.json")
    if File.file?(source)
      configured_ids = %w[IAP_MONTHLY_PRODUCT_ID IAP_QUARTERLY_PRODUCT_ID IAP_LIFETIME_PRODUCT_ID].map { |key| ENV.fetch(key) }
      source_ids = JSON.parse(File.read(source)).values.flat_map { |value| value.fetch("subscriptions", {}).keys }.uniq
      unknown_ids = source_ids - configured_ids
      unless unknown_ids.empty?
        UI.important("Product localizations skipped for unconfigured product IDs: #{unknown_ids.join(', ')}. Match subscriptions keys in #{source} to the configured IAP product IDs.")
      end
    end

    group_name = ENV.fetch("IAP_SUBSCRIPTION_GROUP_NAME")
    groups = asc_collection(api_key, "/v1/apps/#{app.id}/subscriptionGroups?limit=200")
    group = groups.find { |resource| resource.dig("attributes", "referenceName") == group_name }
    unless group
      group = asc_request(api_key, :post, "/v1/subscriptionGroups", body: {
        data: { type: "subscriptionGroups", attributes: { referenceName: group_name }, relationships: { app: { data: { type: "apps", id: app.id } } } }
      }).fetch("data")
      UI.success("Created subscription group #{group_name}.")
    end

    sync_subscription_group_localizations(api_key, group)

    subscription_specs = [
      ["IAP_MONTHLY_REFERENCE_NAME", "IAP_MONTHLY_PRODUCT_ID", "IAP_MONTHLY_PRICE_USD", "ONE_MONTH"],
      ["IAP_QUARTERLY_REFERENCE_NAME", "IAP_QUARTERLY_PRODUCT_ID", "IAP_QUARTERLY_PRICE_USD", "THREE_MONTHS"]
    ]
    subscriptions_path = "/v1/subscriptionGroups/#{group.fetch("id")}/subscriptions?limit=200"
    subscription_specs.each do |name_key, product_key, price_key, period|
      product_id = ENV.fetch(product_key)
      subscription = asc_resource_with_product_id(api_key, subscriptions_path, product_id)
      unless subscription
        subscription = asc_request(api_key, :post, "/v1/subscriptions", body: {
          data: {
            type: "subscriptions",
            # Subscription availability is configured separately through
            # subscriptionPlanAvailabilities, not as a creation attribute.
            attributes: { name: ENV.fetch(name_key), productId: product_id, subscriptionPeriod: period, reviewNote: "In order to see the \"Unlock Premium\":\n\n1. Open the app\n2. Open \"Verb Conjugation\"\n3. Scroll until 3rd word\n4. Click on any part with the \"lock\" icon" },
            relationships: { group: { data: { type: "subscriptionGroups", id: group.fetch("id") } } }
          }
        }).fetch("data")
        UI.success("Created subscription #{product_id}.")
      end
      sync_product_localizations(api_key, subscription, subscription: true)
      ensure_subscription_price(api_key, subscription_id: subscription.fetch("id"), price: ENV.fetch(price_key))
    end

    lifetime_product_id = ENV.fetch("IAP_LIFETIME_PRODUCT_ID")
    # In-app purchase resources use v2 APIs themselves, but Apple's app
    # collection endpoint remains v1 and is named `inAppPurchasesV2`.
    # `/v2/apps/{id}/inAppPurchases` does not exist and returns 404.
    lifetime = asc_resource_with_product_id(api_key, "/v1/apps/#{app.id}/inAppPurchasesV2?limit=200", lifetime_product_id)
    unless lifetime
      lifetime = asc_request(api_key, :post, "/v2/inAppPurchases", body: {
        data: {
          type: "inAppPurchases",
          # The v2 creation API does not accept availableInAllTerritories.
          # Territory availability is a separate inAppPurchaseAvailabilities resource.
          attributes: { name: ENV.fetch("IAP_LIFETIME_REFERENCE_NAME"), productId: lifetime_product_id, inAppPurchaseType: "NON_CONSUMABLE", reviewNote: "In order to see the \"Unlock Premium\":\n\n1. Open the app\n2. Open \"Verb Conjugation\"\n3. Scroll until 3rd word\n4. Click on any part with the \"lock\" icon" },
          relationships: { app: { data: { type: "apps", id: app.id } } }
        }
      }).fetch("data")
      UI.success("Created non-consumable #{lifetime_product_id}.")
    end
    sync_product_localizations(api_key, lifetime, subscription: false)
    ensure_in_app_purchase_price_schedule(api_key, product_id: lifetime.fetch("id"), price: ENV.fetch("IAP_LIFETIME_PRICE_USD", ""))
  end

  def staged_screenshots_are_already_uploaded?(app_identifier)
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    return false unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    return false unless version
    localization = version.get_app_store_version_localizations.find { |item| item.locale == "en-US" }
    return false unless localization

    local_checksums = Dir.glob(File.join(ENV.fetch("SCREENSHOTS_PATH"), "en-US", "*"))
                         .select { |path| File.file?(path) }
                         .map { |path| Digest::MD5.file(path).hexdigest }
    return false if local_checksums.empty?
    remote_checksums = localization.get_app_screenshot_sets
                         .flat_map { |set| set.app_screenshots || [] }
                         .select(&:complete?)
                         .map(&:source_file_checksum)
                         .compact
    (local_checksums - remote_checksums).empty?
  rescue StandardError => error
    # A temporary read failure must not make a release omit required media.
    UI.important("Could not verify existing screenshots; uploading them normally (#{error.message}).")
    false
  end

  lane :create_app do
    # `produce` always uses the Apple ID web flow. Use the App Store Connect
    # API key directly: one lookup and, only when necessary, one create call.
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_filepath: ENV.fetch("ASC_KEY_FILE"), duration: 1_200)
    app_identifier = ENV.fetch("APP_IDENTIFIER")
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    if app
      UI.important("App Store record already exists; continuing with the remaining deployment steps.")
    else
      app = Spaceship::ConnectAPI::App.create(
        name: ENV.fetch("APP_NAME"),
        version_string: get_version_number(xcodeproj: ENV.fetch("XCODEPROJ"), target: ENV.fetch("SCHEME")),
        sku: ENV.fetch("APP_SKU"),
        primary_locale: ENV.fetch("ASC_PRIMARY_LOCALE", "en-US"),
        bundle_id: app_identifier,
        platforms: [Spaceship::ConnectAPI::Platform::IOS]
      )
      UI.success("Requested creation of the App Store Connect record using the API key.")
    end
    ensure_default_products(api_key, app)
  end

  lane :check do
    api_key = app_store_api_key
    app_identifier = ENV.fetch("APP_IDENTIFIER")
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("App Store record does not exist for #{app_identifier}; use --submit to create it before running precheck.") unless app
    # Precheck is also the usual first deployment step. Create the configured
    # products before it runs so the subscription setup is not deferred until
    # a build is uploaded with --submit. The helper only creates missing items.
    ensure_default_products(api_key, app)
    # Validate first, then synchronize only the staged metadata localizations.
    # Deliver needs an editable App Store version for version-localized fields,
    # but skip_binary_upload ensures this lane never archives or uploads a build
    # and submit_for_review remains false.
    precheck(api_key: api_key, app_identifier: app_identifier, default_rule_level: :warn, include_in_app_purchases: false)
    upload_to_app_store(
      api_key: api_key,
      app_identifier: ENV.fetch("APP_IDENTIFIER"),
      metadata_path: ENV.fetch("METADATA_PATH"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
    UI.success("Uploaded staged App Store metadata localizations without a build upload or review submission.")
  end

  lane :set_free_price do
    api_key = app_store_api_key
    app = Spaceship::ConnectAPI::App.find(ENV.fetch("APP_IDENTIFIER"))
    UI.user_error!("App Store record does not exist for #{ENV.fetch("APP_IDENTIFIER")}") unless app

    # A zero-price point in the base territory produces Apple's automatic
    # zero-price equivalents in every storefront. No manual country overrides
    # are created, so future storefronts remain free as well.
    base_territory = "USA"
    points = asc_request(api_key, :get, "/v1/apps/#{app.id}/appPricePoints?filter[territory]=#{base_territory}&limit=200").fetch("data")
    free_point = points.find { |point| point.dig("attributes", "customerPrice").to_f.zero? }
    UI.user_error!("Apple returned no zero-price point for #{base_territory}") unless free_point
    # App Store Connect requires inline resource IDs in `${local-id}` form.
    manual_price_id = '${free-price-' + Time.now.to_i.to_s + '}'
    schedule = {
      data: {
        type: "appPriceSchedules",
        attributes: {},
        relationships: {
          app: { data: { type: "apps", id: app.id } },
          baseTerritory: { data: { type: "territories", id: base_territory } },
          manualPrices: { data: [{ type: "appPrices", id: manual_price_id }] }
        }
      },
      included: [{
        id: manual_price_id,
        type: "appPrices",
        attributes: { startDate: nil, endDate: nil },
        relationships: { appPricePoint: { data: { type: "appPricePoints", id: free_point.fetch("id") } } }
      }]
    }
    asc_request(api_key, :post, "/v1/appPriceSchedules", body: schedule)
    UI.success("Set #{ENV.fetch("APP_IDENTIFIER")} to Apple's global free price (0.00) in every storefront.")
  end

  lane :submit do
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_filepath: ENV.fetch("ASC_KEY_FILE"), duration: 1_200)
    update_app_age_rating(api_key: api_key, app_identifier: ENV.fetch("APP_IDENTIFIER"), age_rating_config_path: ENV.fetch("AGE_RATING_CONFIG_PATH"))
    run_tests(project: ENV.fetch("XCODEPROJ"), scheme: ENV.fetch("SCHEME"), device: ENV.fetch("TEST_DEVICE", "iPhone 17 Pro Max"), clean: true) if ENV.fetch("RUN_TESTS", "1") == "1"
    increment_build_number(xcodeproj: ENV.fetch("XCODEPROJ"), build_number: ENV.fetch("BUILD_NUMBER"))
    # Configure signing before deployment. Implicit provisioning updates can
    # make Xcode authenticate to the Developer Portal with an Apple ID.
    build_app(project: ENV.fetch("XCODEPROJ"), scheme: ENV.fetch("SCHEME"), clean: true, export_method: "app-store")
    # Fastlane 2.240.1 still writes the retired `apps.prices` and
    # `apps.availableTerritories` relationships when `price_tier` is passed.
    # Apple rejects that request before the binary can be uploaded. Set pricing
    # and global availability once in App Store Connect; see the wrapper README.
    # Never reject an in-progress review submission just to retry this lane.
    upload_options = { api_key: api_key, app_identifier: ENV.fetch("APP_IDENTIFIER"), metadata_path: ENV.fetch("METADATA_PATH"), screenshots_path: ENV.fetch("SCREENSHOTS_PATH"), primary_category: ENV.fetch("PRIMARY_CATEGORY", "Education"), copyright: ENV.fetch("COPYRIGHT"), submission_information: { content_rights_contains_third_party_content: ENV.fetch("CONTENT_RIGHTS_DECLARATION") == "third-party" }, app_review_information: { first_name: ENV.fetch("REVIEW_CONTACT_FIRST_NAME"), last_name: ENV.fetch("REVIEW_CONTACT_LAST_NAME"), phone_number: ENV.fetch("REVIEW_CONTACT_PHONE"), email_address: ENV.fetch("REVIEW_CONTACT_EMAIL"), notes: ENV.fetch("REVIEW_NOTES", "No sign-in is required to use the app.") }, submit_for_review: true, automatic_release: ENV.fetch("AUTOMATIC_RELEASE", "0") == "1", force: true, run_precheck_before_submit: true, precheck_include_in_app_purchases: false, reject_if_possible: false }
    if ENV.fetch("SKIP_SCREENSHOTS_IF_UNCHANGED", "1") == "1" && staged_screenshots_are_already_uploaded?(ENV.fetch("APP_IDENTIFIER"))
      upload_options[:skip_screenshots] = true
      UI.important("The exact staged screenshots are already complete in App Store Connect; skipping screenshot upload.")
    end
    upload_options[:app_previews_path] = ENV["APP_PREVIEWS_PATH"] unless ENV["APP_PREVIEWS_PATH"].to_s.empty?
    upload_to_app_store(**upload_options)
  end
end
RUBY

# Bundler 4 no longer supports `bundle install --path`. Keep the dependency
# location stable by storing it in this tool's local Bundler configuration.
(
  cd "$TOOLS_DIR"
  bundle config set --local path "$TOOLS_DIR/vendor/bundle"
)
BUNDLE_GEMFILE="$TOOLS_DIR/Gemfile" bundle check >/dev/null 2>&1 || BUNDLE_GEMFILE="$TOOLS_DIR/Gemfile" bundle install
run_fastlane() {
  (
    cd "$FASTFILE_DIR"
    BUNDLE_GEMFILE="$TOOLS_DIR/Gemfile" bundle exec fastlane "$@"
  )
}
if [[ "$create_app" == "1" ]]; then
  run_fastlane ios create_app
fi
if [[ "$set_free_price" == "1" ]]; then
  run_fastlane ios set_free_price
fi
if [[ "$submit" == "1" ]]; then
  run_fastlane ios submit
else
  run_fastlane ios check
fi
