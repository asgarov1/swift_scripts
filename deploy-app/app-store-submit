#!/usr/bin/env bash
# Submit any Xcode iOS app to App Store Connect from the command line.
set -euo pipefail

TOOLS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
Usage: app-store-submit <app-project-path> [--create-app] [--release] [--no-tests] [--dry-run]

This internal helper is configured by deploy-app, which creates the app
project's .app-store-submit.env. Store metadata belongs at store-metadata/en-US
by default; screenshots and previews default to screenshots/{iphone,ipad} and
previews. No App Store credentials are kept in the project or this script.
EOF
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac
[[ $# -ge 1 ]] || { usage >&2; exit 2; }
PROJECT_DIR="$(cd "$1" 2>/dev/null && pwd)" || { printf 'Project directory not found: %s\n' "$1" >&2; exit 2; }
shift

create_app=0
release=0
dry_run=0
no_tests=0
for argument in "$@"; do
  case "$argument" in
    --create-app) create_app=1 ;;
    --release) release=1 ;;
    --no-tests) no_tests=1 ;;
    --dry-run) dry_run=1 ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'Unknown argument: %s\n' "$argument" >&2; exit 2 ;;
  esac
done

CONFIG_FILE="$PROJECT_DIR/.app-store-submit.env"
[[ -f "$CONFIG_FILE" ]] || { printf 'Missing %s. Run deploy-app first: /Users/asgarov1/Projects/swift/scripts/deploy-app/deploy-app %q\n' "$CONFIG_FILE" "$PROJECT_DIR" >&2; exit 1; }
cd "$PROJECT_DIR"
set -a
# shellcheck disable=SC1090
source "$CONFIG_FILE"
set +a

relative_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PROJECT_DIR" "$1" ;;
  esac
}

required=(APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL BUILD_NUMBER COPYRIGHT CONTENT_RIGHTS_DECLARATION APP_DATA_USAGE_DECLARATION PRICE_TIER AVAILABLE_IN_ALL_TERRITORIES AGE_RATING_CONFIG_PATH)
for variable in "${required[@]}"; do
  [[ -n "${!variable:-}" ]] || { printf 'Missing %s in %s\n' "$variable" "$CONFIG_FILE" >&2; exit 1; }
done
METADATA_PATH="$(relative_path "${METADATA_PATH:-store-metadata}")"
PREVIEW_PATH="$(relative_path "${PREVIEW_PATH:-previews}")"
ASC_KEY_FILE="$(relative_path "$ASC_KEY_FILE")"
XCODEPROJ="$(relative_path "$XCODEPROJ")"
export METADATA_PATH ASC_KEY_FILE XCODEPROJ
AGE_RATING_CONFIG_PATH="$(relative_path "$AGE_RATING_CONFIG_PATH")"
export AGE_RATING_CONFIG_PATH
[[ -d "$XCODEPROJ" ]] || { printf 'Xcode project not found: %s\n' "$XCODEPROJ" >&2; exit 1; }
[[ -f "$ASC_KEY_FILE" ]] || { printf 'API key not found: %s\n' "$ASC_KEY_FILE" >&2; exit 1; }
[[ -d "$METADATA_PATH/en-US" ]] || { printf 'Metadata directory not found: %s/en-US\n' "$METADATA_PATH" >&2; exit 1; }
[[ -f "$AGE_RATING_CONFIG_PATH" ]] || { printf 'Age-rating configuration not found: %s\n' "$AGE_RATING_CONFIG_PATH" >&2; exit 1; }
case "$AVAILABLE_IN_ALL_TERRITORIES" in 0|1) ;; *) printf 'AVAILABLE_IN_ALL_TERRITORIES must be 0 or 1\n' >&2; exit 1 ;; esac
case "${SKIP_SCREENSHOTS_IF_UNCHANGED:-1}" in 0|1) ;; *) printf 'SKIP_SCREENSHOTS_IF_UNCHANGED must be 0 or 1\n' >&2; exit 1 ;; esac
case "$APP_DATA_USAGE_DECLARATION" in not-collected|configured) ;; *) printf 'APP_DATA_USAGE_DECLARATION must be not-collected or configured\n' >&2; exit 1 ;; esac
[[ "$PRICE_TIER" =~ ^[0-9]+$ ]] || { printf 'PRICE_TIER must be a non-negative integer\n' >&2; exit 1; }

ASSET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/app-store-assets.XXXXXX")"
PREVIEW_ASSET_DIR="$(mktemp -d "${TMPDIR:-/tmp}/app-store-previews.XXXXXX")"
FASTFILE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/app-store-fastlane.XXXXXX")"
cleanup() { rm -rf "$ASSET_DIR" "$PREVIEW_ASSET_DIR" "$FASTFILE_DIR"; }
trap cleanup EXIT
mkdir -p "$ASSET_DIR/en-US"
mkdir -p "$PREVIEW_ASSET_DIR/en-US"

screenshot_dimensions() {
  local width height
  width="$(sips -g pixelWidth "$1" 2>/dev/null | awk '/pixelWidth:/{print $2}')"
  height="$(sips -g pixelHeight "$1" 2>/dev/null | awk '/pixelHeight:/{print $2}')"
  [[ -n "$width" && -n "$height" ]] || { printf 'Could not read screenshot dimensions: %s\n' "$1" >&2; exit 1; }
  printf '%sx%s\n' "$width" "$height"
}

valid_screenshot_dimensions() {
  local device="$1" dimensions="$2"
  case "$device:$dimensions" in
    # Highest App Store Connect screenshot families: iPhone 6.9-inch and iPad 13-inch.
    iphone:1260x2736|iphone:2736x1260|iphone:1290x2796|iphone:2796x1290|iphone:1320x2868|iphone:2868x1320|ipad:2064x2752|ipad:2752x2064|ipad:2048x2732|ipad:2732x2048) return 0 ;;
    *) return 1 ;;
  esac
}

screenshot_count=0
iphone_screenshot_count=0
ipad_screenshot_count=0
for source_dir in ${SCREENSHOT_PATHS:-screenshots/iphone screenshots/ipad}; do
  source_dir="$(relative_path "$source_dir")"
  [[ -d "$source_dir" ]] || continue
  device_family="$(basename "$source_dir")"
  case "$device_family" in
    iphone|ipad) ;;
    *) printf 'Screenshot directory must end in iphone or ipad: %s\n' "$source_dir" >&2; exit 1 ;;
  esac
  for screenshot in "$source_dir"/*.png "$source_dir"/*.jpg "$source_dir"/*.jpeg; do
    [[ -f "$screenshot" ]] || continue
    dimensions="$(screenshot_dimensions "$screenshot")"
    valid_screenshot_dimensions "$device_family" "$dimensions" || { printf 'Screenshot must use the highest %s App Store size; got %s: %s\n' "$device_family" "$dimensions" "$screenshot" >&2; exit 1; }
    [[ "$(sips -g hasAlpha "$screenshot" 2>/dev/null | awk '/hasAlpha:/{print $2}')" != "yes" ]] || { printf 'Screenshots cannot contain transparency: %s\n' "$screenshot" >&2; exit 1; }
    screenshot_count=$((screenshot_count + 1))
    if [[ "$device_family" == "iphone" ]]; then
      iphone_screenshot_count=$((iphone_screenshot_count + 1))
    else
      ipad_screenshot_count=$((ipad_screenshot_count + 1))
    fi
    cp "$screenshot" "$ASSET_DIR/en-US/${device_family}-$(printf '%02d' "$screenshot_count")-$(basename "$screenshot")"
  done
done
[[ "$screenshot_count" -gt 0 ]] || { printf 'No screenshots found. Check SCREENSHOT_PATHS.\n' >&2; exit 1; }
[[ "$iphone_screenshot_count" -le 10 && "$ipad_screenshot_count" -le 10 ]] || { printf 'App Store Connect permits at most 10 screenshots per device family.\n' >&2; exit 1; }

preview_count=0
iphone_preview_count=0
ipad_preview_count=0
for preview in "$PREVIEW_PATH"/*.mp4 "$PREVIEW_PATH"/*.mov "$PREVIEW_PATH"/*.m4v; do
  [[ -f "$preview" ]] || continue
  [[ -x "$(command -v ffprobe)" ]] || { printf 'ffprobe is required to validate App Preview videos.\n' >&2; exit 1; }
  preview_name="$(basename "$preview")"
  preview_name_lower="$(printf '%s' "$preview_name" | tr '[:upper:]' '[:lower:]')"
  case "$preview_name_lower" in
    *iphone_67*) preview_family=iphone; expected_preview_dimensions='886x1920|1920x886'; iphone_preview_count=$((iphone_preview_count + 1)) ;;
    *ipad_pro_3gen_129*) preview_family=ipad; expected_preview_dimensions='1200x1600|1600x1200'; ipad_preview_count=$((ipad_preview_count + 1)) ;;
    *) printf 'App Preview filename must include IPHONE_67 or IPAD_PRO_3GEN_129: %s\n' "$preview" >&2; exit 1 ;;
  esac
  preview_width="$(ffprobe -v error -select_streams v:0 -show_entries stream=width -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_height="$(ffprobe -v error -select_streams v:0 -show_entries stream=height -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_fps="$(ffprobe -v error -select_streams v:0 -show_entries stream=r_frame_rate -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_codec="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "$preview")"
  preview_dimensions="${preview_width}x${preview_height}"
  [[ "$preview_dimensions" =~ ^($expected_preview_dimensions)$ ]] || { printf 'App Preview dimensions do not match the highest %s family: %s\n' "$preview_family" "$preview" >&2; exit 1; }
  awk -v duration="$preview_duration" 'BEGIN { exit !(duration >= 15 && duration <= 30) }' || { printf 'App Preview must be 15-30 seconds: %s\n' "$preview" >&2; exit 1; }
  awk -v fps="$preview_fps" 'BEGIN { split(fps, rate, "/"); exit !(rate[2] > 0 && rate[1] / rate[2] <= 30) }' || { printf 'App Preview frame rate must not exceed 30 fps: %s\n' "$preview" >&2; exit 1; }
  [[ "$preview_codec" == "h264" || "$preview_codec" == "prores" ]] || { printf 'App Preview must use H.264 or ProRes: %s\n' "$preview" >&2; exit 1; }
  [[ "$preview_codec" != "prores" || "$preview_name_lower" == *.mov ]] || { printf 'ProRes App Previews must use a .mov extension: %s\n' "$preview" >&2; exit 1; }
  [[ "$(stat -f %z "$preview")" -le 524288000 ]] || { printf 'App Preview exceeds 500 MB: %s\n' "$preview" >&2; exit 1; }
  preview_count=$((preview_count + 1))
  cp "$preview" "$PREVIEW_ASSET_DIR/en-US/$preview_name"
done
[[ "$iphone_preview_count" -le 3 && "$ipad_preview_count" -le 3 ]] || { printf 'App Store Connect permits at most 3 App Previews per device family.\n' >&2; exit 1; }
export SCREENSHOTS_PATH="$ASSET_DIR"
[[ "$preview_count" -gt 0 ]] && export APP_PREVIEWS_PATH="$PREVIEW_ASSET_DIR"
export AUTOMATIC_RELEASE="$release"
export SKIP_SCREENSHOTS_IF_UNCHANGED="${SKIP_SCREENSHOTS_IF_UNCHANGED:-1}"
[[ "$no_tests" == "1" ]] && export RUN_TESTS=0

if [[ "$dry_run" == "1" ]]; then
  printf 'Validated %s and staged assets. No Apple service was contacted.\n' "$PROJECT_DIR"
  exit 0
fi

mkdir -p "$FASTFILE_DIR/fastlane"
cat > "$FASTFILE_DIR/fastlane/Fastfile" <<'RUBY'
default_platform(:ios)
require "digest/md5"

platform :ios do
  def app_data_usage_is_published!(app_identifier)
    declaration = ENV.fetch("APP_DATA_USAGE_DECLARATION")
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    UI.user_error!("Could not find App Store Connect app '#{app_identifier}' to verify its data-use declaration.") unless app

    unless %w[not-collected configured].include?(declaration)
      UI.user_error!("APP_DATA_USAGE_DECLARATION must be not-collected or configured.")
    end

    # Apple removed the dataUsagePublishState and appDataUsages relationships
    # from the public App Store Connect API. Do not call Fastlane's stale
    # wrappers here: they fail with a 404 before deliver can submit the app.
    # Privacy answers must be completed and published in App Store Connect.
    UI.important!("App privacy answers cannot be read or published with the App Store Connect API. Confirm that the truthful answers are published in App Store Connect before continuing (APP_DATA_USAGE_DECLARATION=#{declaration}).")
  end

  def staged_screenshots_are_already_uploaded?(app_identifier)
    app = Spaceship::ConnectAPI::App.find(app_identifier)
    return false unless app
    version = app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    return false unless version
    localization = version.get_app_store_version_localizations.find { |item| item.locale == "en-US" }
    return false unless localization

    local_checksums = Dir.glob(File.join(ENV.fetch("SCREENSHOTS_PATH"), "en-US", "*"))
                         .select { |path| File.file?(path) }
                         .map { |path| Digest::MD5.file(path).hexdigest }
    return false if local_checksums.empty?
    remote_checksums = localization.get_app_screenshot_sets
                         .flat_map { |set| set.app_screenshots || [] }
                         .select(&:complete?)
                         .map(&:source_file_checksum)
                         .compact
    (local_checksums - remote_checksums).empty?
  rescue StandardError => error
    # A temporary read failure must not make a release omit required media.
    UI.important("Could not verify existing screenshots; uploading them normally (#{error.message}).")
    false
  end

  lane :create_app do
    UI.user_error!("APPLE_ID is required for --create-app") if ENV["APPLE_ID"].to_s.empty?
    UI.user_error!("FASTLANE_SESSION is required for --create-app") if ENV["FASTLANE_SESSION"].to_s.empty?
    begin
      produce(username: ENV.fetch("APPLE_ID"), app_identifier: ENV.fetch("APP_IDENTIFIER"), app_name: ENV.fetch("APP_NAME"), sku: ENV.fetch("APP_SKU"), platform: "ios", language: ENV.fetch("ASC_PRIMARY_LANGUAGE", "English"), app_version: get_version_number(xcodeproj: ENV.fetch("XCODEPROJ"), target: ENV.fetch("SCHEME")), skip_itc: false)
    rescue StandardError => error
      # A prior run can create this record before a later upload step fails.
      # Fastlane's exact wording differs across Apple backend responses.
      raise unless error.message.match?(/already exists|duplicate|bundle identifier.*exist/i)
      UI.important("App Store record already exists; continuing with the remaining deployment steps.")
    end
  end

  lane :submit do
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"), key_filepath: ENV.fetch("ASC_KEY_FILE"), duration: 1_200)
    app_data_usage_is_published!(ENV.fetch("APP_IDENTIFIER"))
    update_app_age_rating(api_key: api_key, app_identifier: ENV.fetch("APP_IDENTIFIER"), age_rating_config_path: ENV.fetch("AGE_RATING_CONFIG_PATH"))
    run_tests(project: ENV.fetch("XCODEPROJ"), scheme: ENV.fetch("SCHEME"), device: ENV.fetch("TEST_DEVICE", "iPhone 17 Pro Max"), clean: true) if ENV.fetch("RUN_TESTS", "1") == "1"
    increment_build_number(xcodeproj: ENV.fetch("XCODEPROJ"), build_number: ENV.fetch("BUILD_NUMBER"))
    build_app(project: ENV.fetch("XCODEPROJ"), scheme: ENV.fetch("SCHEME"), clean: true, export_method: "app-store", xcargs: "-allowProvisioningUpdates")
    # Fastlane 2.240.1 still writes the retired `apps.prices` and
    # `apps.availableTerritories` relationships when `price_tier` is passed.
    # Apple rejects that request before the binary can be uploaded. Set pricing
    # and global availability once in App Store Connect; see the wrapper README.
    # Never reject an in-progress review submission just to retry this lane.
    upload_options = { api_key: api_key, app_identifier: ENV.fetch("APP_IDENTIFIER"), metadata_path: ENV.fetch("METADATA_PATH"), screenshots_path: ENV.fetch("SCREENSHOTS_PATH"), primary_category: ENV.fetch("PRIMARY_CATEGORY", "Education"), copyright: ENV.fetch("COPYRIGHT"), submission_information: { content_rights_contains_third_party_content: ENV.fetch("CONTENT_RIGHTS_DECLARATION") == "third-party" }, app_review_information: { first_name: ENV.fetch("REVIEW_CONTACT_FIRST_NAME"), last_name: ENV.fetch("REVIEW_CONTACT_LAST_NAME"), phone_number: ENV.fetch("REVIEW_CONTACT_PHONE"), email_address: ENV.fetch("REVIEW_CONTACT_EMAIL"), notes: ENV.fetch("REVIEW_NOTES", "No sign-in is required to use the app.") }, submit_for_review: true, automatic_release: ENV.fetch("AUTOMATIC_RELEASE", "0") == "1", force: true, run_precheck_before_submit: true, precheck_include_in_app_purchases: false, reject_if_possible: false }
    if ENV.fetch("SKIP_SCREENSHOTS_IF_UNCHANGED", "1") == "1" && staged_screenshots_are_already_uploaded?(ENV.fetch("APP_IDENTIFIER"))
      upload_options[:skip_screenshots] = true
      UI.important("The exact staged screenshots are already complete in App Store Connect; skipping screenshot upload.")
    end
    upload_options[:app_previews_path] = ENV["APP_PREVIEWS_PATH"] unless ENV["APP_PREVIEWS_PATH"].to_s.empty?
    upload_to_app_store(**upload_options)
  end
end
RUBY

# Bundler 4 no longer supports `bundle install --path`. Keep the dependency
# location stable by storing it in this tool's local Bundler configuration.
(
  cd "$TOOLS_DIR"
  bundle config set --local path "$TOOLS_DIR/vendor/bundle"
)
BUNDLE_GEMFILE="$TOOLS_DIR/Gemfile" bundle check >/dev/null 2>&1 || BUNDLE_GEMFILE="$TOOLS_DIR/Gemfile" bundle install
run_fastlane() {
  (
    cd "$FASTFILE_DIR"
    BUNDLE_GEMFILE="$TOOLS_DIR/Gemfile" bundle exec fastlane "$@"
  )
}
if [[ "$create_app" == "1" ]]; then
  run_fastlane ios create_app
fi
run_fastlane ios submit
