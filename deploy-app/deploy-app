#!/usr/bin/env bash
# Prepare the complete first-release App Store Connect metadata, then delegate
# the archive/upload/submission to a project submission script.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="$SCRIPT_DIR/deploy-app.env.example"
DEFAULTS_ENV="$SCRIPT_DIR/deploy-app.defaults.env"
SECRETS_ENV="$SCRIPT_DIR/deploy-app.secrets.env"

usage() {
  cat <<'EOF'
Usage: deploy-app <app-project-path> [--configure] [--init] [--dry-run] [--release] [--no-tests] [--force]

The bundled app-store-submit helper archives, uploads, and submits the app.

On the first run, a missing .deploy-app.env is created interactively. The
script offers inferred defaults where possible and asks for the remaining
truthful App Store Connect, legal, review, and metadata values. --init remains
available to create only the example file. Use --configure to review or change
saved answers. The command creates the
app-store-submit configuration and Fastlane Deliver metadata before calling
the submission script. Before an App Store upload, it publishes the configured
privacy-policy Markdown file to the Privacy-Policies GitHub Pages repository
and verifies its public URL. A successful deployment is recorded locally and
is skipped on later runs when RELEASE_VERSION and the configuration are
unchanged. Use --force to deliberately run it again.
EOF
}

fail() { printf 'deploy-app: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac
[[ $# -ge 1 ]] || { usage >&2; exit 2; }
PROJECT_INPUT="$1"
PROJECT_DIR="$PROJECT_INPUT"
shift

SUBMISSION_SCRIPT="$SCRIPT_DIR/app-store-submit"
[[ -f "$SUBMISSION_SCRIPT" ]] || fail "Bundled submission script not found: $SUBMISSION_SCRIPT"
[[ -x "$SUBMISSION_SCRIPT" ]] || fail "Submission script is not executable: $SUBMISSION_SCRIPT"
[[ -f "$DEFAULTS_ENV" ]] || fail "Bundled defaults file not found: $DEFAULTS_ENV"
source "$DEFAULTS_ENV"
FASTLANE_SESSION_FROM_SECRETS=""
if [[ -f "$SECRETS_ENV" ]]; then
  source "$SECRETS_ENV"
  FASTLANE_SESSION_FROM_SECRETS="${FASTLANE_SESSION:-}"
fi
PROJECT_DIR="$(cd "$PROJECT_DIR" 2>/dev/null && pwd)" || fail "Project directory not found: $PROJECT_INPUT"

init=0
dry_run=0
release=0
no_tests=0
force=0
configure=0
for argument in "$@"; do
  case "$argument" in
    --configure) configure=1 ;;
    --init) init=1 ;;
    --dry-run) dry_run=1 ;;
    --release) release=1 ;;
    --no-tests) no_tests=1 ;;
    --force) force=1 ;;
    --help|-h) usage; exit 0 ;;
    *) fail "Unknown argument: $argument" ;;
  esac
done

DEPLOY_ENV="$PROJECT_DIR/.deploy-app.env"
if [[ "$init" == 1 ]]; then
  if [[ -e "$PROJECT_DIR/.deploy-app.env.example" ]]; then
    printf 'Keeping existing %s.\n' "$PROJECT_DIR/.deploy-app.env.example"
  else
    cp "$TEMPLATE" "$PROJECT_DIR/.deploy-app.env.example"
    printf 'Created %s.\n' "$PROJECT_DIR/.deploy-app.env.example"
  fi
  mkdir -p "$PROJECT_DIR/store-metadata/en-US"
  [[ -e "$DEPLOY_ENV" ]] && printf 'Keeping existing %s.\n' "$DEPLOY_ENV" || printf 'Run deploy-app normally to create %s interactively.\n' "$DEPLOY_ENV"
  exit 0
fi

find_privacy_policies_repo() {
  local candidate="$PROJECT_DIR"
  while [[ "$candidate" != / ]]; do
    if [[ -d "$candidate/Privacy-Policies/.git" ]]; then
      printf '%s\n' "$candidate/Privacy-Policies"
      return
    fi
    candidate="$(dirname "$candidate")"
  done
}

project_value() {
  local key="$1"
  local project_file
  project_file="$(find "$PROJECT_DIR" -maxdepth 2 -name project.pbxproj -path '*.xcodeproj/project.pbxproj' -print -quit)"
  [[ -n "$project_file" ]] || return
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*" key " = " {
      value = $0
      sub("^[[:space:]]*" key " = ", "", value)
      sub(";[[:space:]]*$", "", value)
      gsub(/\"/, "", value)
      if (value !~ /Tests$/) { print value; exit }
    }
  ' "$project_file"
}

app_config_value() {
  local pattern="$1"
  local source
  source="$(rg -l -m1 'AppConfig\(' "$PROJECT_DIR" --glob '*.swift' | head -1 || true)"
  [[ -n "$source" ]] || return
  sed -nE "$pattern" "$source" | head -1
}

prompt_value() {
  local variable="$1" label="$2" default_value="$3" required="$4" secret="${5:-0}"
  local response prompt
  if [[ "$configure" != 1 && -n "${!variable:-}" ]]; then
    return
  fi
  while :; do
    prompt="$label"
    [[ -n "$default_value" ]] && prompt+=" [$default_value]"
    prompt+=": "
    if [[ "$secret" == 1 ]]; then
      read -r -s -p "$prompt" response < /dev/tty
      printf '\n' > /dev/tty
    else
      read -r -p "$prompt" response < /dev/tty
    fi
    response="${response:-$default_value}"
    if [[ "$required" == 0 || -n "$response" ]]; then
      printf -v "$variable" '%s' "$response"
      return
    fi
    printf '%s is required.\n' "$label" > /dev/tty
  done
}

ensure_secret_files_ignored() {
  local ignore_file entry
  ignore_file="$PROJECT_DIR/.gitignore"
  for entry in '.deploy-app.env' '.app-store-submit.env' '.deploy-app-state'; do
    rg -qxF "$entry" "$ignore_file" 2>/dev/null || printf '%s\n' "$entry" >> "$ignore_file"
  done
}

write_deploy_env() {
  local variable
  umask 077
  {
    printf '# Generated by deploy-app. This file contains credentials; do not commit it.\n'
    for variable in APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE APPLE_ID FASTLANE_SESSION REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL REVIEW_NOTES PRIMARY_CATEGORY COPYRIGHT SUPPORT_URL LANGUAGE_NAME LANGUAGE_LEVEL PRIVACY_URL SUBTITLE DESCRIPTION KEYWORDS PROMOTIONAL_TEXT RELEASE_NOTES PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH CONTENT_RIGHTS_DECLARATION USES_IDFA USES_NON_EXEMPT_ENCRYPTION SCREENSHOT_PATHS PREVIEW_PATH RUN_TESTS TEST_DEVICE BUILD_NUMBER AUTOMATIC_RELEASE RELEASE_VERSION; do
      printf '%s=%q\n' "$variable" "${!variable}"
    done
  } > "$DEPLOY_ENV"
  ensure_secret_files_ignored
  printf 'Created %s. Future runs preserve it without prompting.\n' "$DEPLOY_ENV"
}

interactive_setup() {
  local xcodeproj scheme identifier app_name language language_level privacy_source privacy_repo policy_slug privacy_url copyright_owner build_number
  [[ -t 0 && -r /dev/tty ]] || fail "Missing $DEPLOY_ENV and no interactive terminal is available. Create it from .deploy-app.env.example."
  [[ -e "$PROJECT_DIR/.deploy-app.env.example" ]] || cp "$TEMPLATE" "$PROJECT_DIR/.deploy-app.env.example"
  mkdir -p "$PROJECT_DIR/store-metadata/en-US"

  xcodeproj="$(basename "$(find "$PROJECT_DIR" -maxdepth 1 -type d -name '*.xcodeproj' -print -quit)")"
  scheme="${xcodeproj%.xcodeproj}"
  identifier="$(project_value PRODUCT_BUNDLE_IDENTIFIER)"
  app_name="$(app_config_value 's/.*appName:[[:space:]]*"([^"]+)".*/\1/p')"
  language="$(app_config_value 's/.*learningLanguage:[[:space:]]*\.([[:alpha:]]+).*/\1/p')"
  [[ -n "$language" ]] && language="$(printf '%s' "$language" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }')"
  language_level="$(app_config_value 's/.*certificateLevel:[[:space:]]*"([^"]+)".*/\1/p')"
  privacy_source="$(find "$PROJECT_DIR" -maxdepth 1 -type f -iname '*privacy*.md' -print -quit)"
  privacy_source="${privacy_source#"$PROJECT_DIR/"}"
  privacy_repo="$(find_privacy_policies_repo || true)"
  policy_slug="$(basename "$PROJECT_DIR" | tr '-' '_')_privacyPolicy.md"
  privacy_url="https://asgarov1.github.io/Privacy-Policies/${policy_slug%.md}"
  copyright_owner="$(git config --get user.name 2>/dev/null || true)"
  build_number="$(project_value CURRENT_PROJECT_VERSION)"

  printf 'No deployment configuration found. Set it up now; press Enter to accept a value in brackets.\n' > /dev/tty
  prompt_value APP_IDENTIFIER 'Bundle identifier' "${APP_IDENTIFIER:-$identifier}" 1
  prompt_value APP_NAME 'App Store name' "${APP_NAME:-${app_name:-$scheme}}" 1
  prompt_value APP_SKU 'App Store SKU' "${APP_SKU:-${identifier:-$scheme}}" 1
  prompt_value SCHEME 'Xcode scheme' "${SCHEME:-$scheme}" 1
  prompt_value XCODEPROJ 'Xcode project' "${XCODEPROJ:-$xcodeproj}" 1
  prompt_value ASC_KEY_ID 'App Store Connect API key ID' "${ASC_KEY_ID:-}" 1
  prompt_value ASC_ISSUER_ID 'App Store Connect issuer ID' "${ASC_ISSUER_ID:-}" 1
  prompt_value ASC_KEY_FILE 'App Store Connect API key .p8 path' "${ASC_KEY_FILE:-}" 1
  prompt_value APPLE_ID 'Apple ID email for initial app creation' "${APPLE_ID:-}" 1
  [[ -n "$FASTLANE_SESSION_FROM_SECRETS" ]] || prompt_value FASTLANE_SESSION 'Fastlane session' "${FASTLANE_SESSION:-}" 1 1
  prompt_value REVIEW_CONTACT_FIRST_NAME 'App Review contact first name' "${REVIEW_CONTACT_FIRST_NAME:-}" 1
  prompt_value REVIEW_CONTACT_LAST_NAME 'App Review contact last name' "${REVIEW_CONTACT_LAST_NAME:-}" 1
  prompt_value REVIEW_CONTACT_PHONE 'App Review contact phone' "${REVIEW_CONTACT_PHONE:-}" 1
  prompt_value REVIEW_CONTACT_EMAIL 'App Review contact email' "${REVIEW_CONTACT_EMAIL:-}" 1
  prompt_value REVIEW_NOTES 'App Review notes' "${REVIEW_NOTES:-No sign-in is required to use the app.}" 1
  prompt_value PRIMARY_CATEGORY 'Primary category' "${PRIMARY_CATEGORY:-Education}" 1
  prompt_value COPYRIGHT 'Copyright' "${COPYRIGHT:-$(date +%Y) ${copyright_owner:-Your Company}}" 1
  prompt_value SUPPORT_URL 'Support URL' "${SUPPORT_URL:-}" 1
  prompt_value LANGUAGE_NAME 'Learning language (leave blank for a non-language app)' "${LANGUAGE_NAME:-$language}" 0
  prompt_value LANGUAGE_LEVEL 'Learning level (leave blank for a non-language app)' "${LANGUAGE_LEVEL:-$language_level}" 0
  prompt_value PRIVACY_POLICY_SOURCE 'Privacy-policy source file' "${PRIVACY_POLICY_SOURCE:-$privacy_source}" 1
  prompt_value PRIVACY_POLICIES_REPO 'Privacy Policies repository' "${PRIVACY_POLICIES_REPO:-$privacy_repo}" 1
  prompt_value PRIVACY_POLICY_PUBLISHED_PATH 'Published privacy-policy path' "${PRIVACY_POLICY_PUBLISHED_PATH:-$policy_slug}" 1
  privacy_url="https://asgarov1.github.io/Privacy-Policies/${PRIVACY_POLICY_PUBLISHED_PATH%.md}"
  prompt_value PRIVACY_URL 'Privacy-policy URL' "${PRIVACY_URL:-$privacy_url}" 1
  prompt_value SUBTITLE 'Subtitle (optional)' "${SUBTITLE:-}" 0
  local copy_required=0
  [[ -z "$LANGUAGE_NAME" && -z "$LANGUAGE_LEVEL" ]] && copy_required=1
  prompt_value DESCRIPTION 'Description (optional for language apps)' "${DESCRIPTION:-}" "$copy_required"
  prompt_value KEYWORDS 'Keywords (optional for language apps)' "${KEYWORDS:-}" "$copy_required"
  prompt_value PROMOTIONAL_TEXT 'Promotional text (optional)' "${PROMOTIONAL_TEXT:-}" 0
  prompt_value RELEASE_NOTES 'Release notes' "${RELEASE_NOTES:-Initial release.}" 1
  prompt_value CONTENT_RIGHTS_DECLARATION 'Content rights: owns or third-party' "${CONTENT_RIGHTS_DECLARATION:-owns}" 1
  prompt_value USES_IDFA 'Uses advertising identifier: 0 or 1' "${USES_IDFA:-0}" 1
  prompt_value USES_NON_EXEMPT_ENCRYPTION 'Uses non-exempt encryption: 0 or 1' "${USES_NON_EXEMPT_ENCRYPTION:-0}" 1
  prompt_value SCREENSHOT_PATHS 'Screenshot paths' "${SCREENSHOT_PATHS:-screenshots/iphone screenshots/ipad}" 1
  prompt_value PREVIEW_PATH 'App Preview path' "${PREVIEW_PATH:-previews}" 1
  prompt_value RUN_TESTS 'Run tests: 0 or 1' "${RUN_TESTS:-1}" 1
  prompt_value TEST_DEVICE 'Test device' "${TEST_DEVICE:-iPhone 17 Pro Max}" 1
  prompt_value BUILD_NUMBER 'Build number (kept fixed across retries)' "${BUILD_NUMBER:-$build_number}" 1
  prompt_value AUTOMATIC_RELEASE 'Release automatically after approval: 0 or 1' "${AUTOMATIC_RELEASE:-0}" 1
  prompt_value RELEASE_VERSION 'App Store version' "${RELEASE_VERSION:-$(project_value MARKETING_VERSION)}" 1
  write_deploy_env
}

if [[ -f "$DEPLOY_ENV" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$DEPLOY_ENV"
  set +a
fi
[[ -n "${FASTLANE_SESSION:-}" || -z "$FASTLANE_SESSION_FROM_SECRETS" ]] || FASTLANE_SESSION="$FASTLANE_SESSION_FROM_SECRETS"
config_needs_answers() {
  local variable
  for variable in APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE APPLE_ID FASTLANE_SESSION REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL REVIEW_NOTES PRIMARY_CATEGORY COPYRIGHT SUPPORT_URL PRIVACY_URL RELEASE_NOTES PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH CONTENT_RIGHTS_DECLARATION USES_IDFA USES_NON_EXEMPT_ENCRYPTION RUN_TESTS AUTOMATIC_RELEASE BUILD_NUMBER RELEASE_VERSION; do
    [[ -n "${!variable:-}" ]] || return 0
  done
  if [[ -z "${LANGUAGE_NAME:-}" && -z "${LANGUAGE_LEVEL:-}" ]]; then
    [[ -n "${DESCRIPTION:-}" && -n "${KEYWORDS:-}" ]] || return 0
  fi
  return 1
}

if [[ ! -f "$DEPLOY_ENV" || "$configure" == 1 ]] || config_needs_answers; then
  interactive_setup
fi
set -a
# shellcheck disable=SC1090
source "$DEPLOY_ENV"
set +a
[[ -n "${FASTLANE_SESSION:-}" || -z "$FASTLANE_SESSION_FROM_SECRETS" ]] || FASTLANE_SESSION="$FASTLANE_SESSION_FROM_SECRETS"

required=(
  APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE
  APPLE_ID FASTLANE_SESSION REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME
  REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL PRIMARY_CATEGORY COPYRIGHT
  SUPPORT_URL PRIVACY_URL RELEASE_NOTES
  PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH
  CONTENT_RIGHTS_DECLARATION USES_IDFA USES_NON_EXEMPT_ENCRYPTION BUILD_NUMBER RELEASE_VERSION
)
for variable in "${required[@]}"; do
  [[ -n "${!variable:-}" ]] || fail "Missing $variable in $DEPLOY_ENV"
done

case "$USES_IDFA" in 0|1) ;; *) fail "USES_IDFA must be 0 or 1" ;; esac
case "$USES_NON_EXEMPT_ENCRYPTION" in 0|1) ;; *) fail "USES_NON_EXEMPT_ENCRYPTION must be 0 or 1" ;; esac
case "$RUN_TESTS" in 0|1) ;; *) fail "RUN_TESTS must be 0 or 1" ;; esac
case "$AUTOMATIC_RELEASE" in 0|1) ;; *) fail "AUTOMATIC_RELEASE must be 0 or 1" ;; esac
[[ "$BUILD_NUMBER" =~ ^[1-9][0-9]*$ ]] || fail "BUILD_NUMBER must be a positive integer"
[[ "$SUPPORT_URL" =~ ^https:// ]] || fail "SUPPORT_URL must begin with https://"
[[ "$PRIVACY_URL" =~ ^https:// ]] || fail "PRIVACY_URL must begin with https://"
[[ "$CONTENT_RIGHTS_DECLARATION" == "owns" || "$CONTENT_RIGHTS_DECLARATION" == "third-party" ]] || fail "CONTENT_RIGHTS_DECLARATION must be owns or third-party"

if [[ -n "${LANGUAGE_NAME:-}" || -n "${LANGUAGE_LEVEL:-}" ]]; then
  [[ -n "${LANGUAGE_NAME:-}" && -n "${LANGUAGE_LEVEL:-}" ]] || fail "Set both LANGUAGE_NAME and LANGUAGE_LEVEL, or neither"
  language_lower="$(printf '%s' "$LANGUAGE_NAME" | tr '[:upper:]' '[:lower:]')"
  DESCRIPTION="${DESCRIPTION:-Jlingo $LANGUAGE_NAME $LANGUAGE_LEVEL is a focused language-learning app for building practical $LANGUAGE_NAME skills. Study vocabulary, verbs, grammar, and useful phrases through short, structured lessons and quizzes. Build a consistent learning habit, review what you have studied, and grow your confidence one lesson at a time. Designed for independent learners working toward the $LANGUAGE_LEVEL level.}"
  KEYWORDS="${KEYWORDS:-learn $language_lower,$language_lower lessons,$LANGUAGE_LEVEL,vocabulary,grammar,verbs,phrases,language learning}"
fi
[[ -n "${DESCRIPTION:-}" ]] || fail "Missing DESCRIPTION in $DEPLOY_ENV (or set LANGUAGE_NAME and LANGUAGE_LEVEL for the Jlingo default)"
[[ -n "${KEYWORDS:-}" ]] || fail "Missing KEYWORDS in $DEPLOY_ENV (or set LANGUAGE_NAME and LANGUAGE_LEVEL for the Jlingo default)"
SUBTITLE="${SUBTITLE:-}"
PROMOTIONAL_TEXT="${PROMOTIONAL_TEXT:-}"
[[ ${#SUBTITLE} -le 30 ]] || fail "SUBTITLE exceeds App Store Connect's 30-character limit"
[[ ${#DESCRIPTION} -le 4000 ]] || fail "DESCRIPTION exceeds App Store Connect's 4,000-character limit"
[[ ${#KEYWORDS} -le 100 ]] || fail "KEYWORDS exceeds App Store Connect's 100-character limit"
[[ ${#PROMOTIONAL_TEXT} -le 170 ]] || fail "PROMOTIONAL_TEXT exceeds App Store Connect's 170-character limit"

relative_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PROJECT_DIR" "$1" ;;
  esac
}

publish_privacy_policy() {
  local source policy_repo published_path expected_url source_name
  source="$(relative_path "$PRIVACY_POLICY_SOURCE")"
  policy_repo="$PRIVACY_POLICIES_REPO"
  [[ "$policy_repo" = /* ]] || policy_repo="$(relative_path "$policy_repo")"
  published_path="$PRIVACY_POLICY_PUBLISHED_PATH"
  [[ "$published_path" != /* && "$published_path" != *".."* ]] || fail "PRIVACY_POLICY_PUBLISHED_PATH must be a repository-relative path without .."
  [[ "$published_path" == *.md ]] || fail "PRIVACY_POLICY_PUBLISHED_PATH must name a Markdown file ending in .md"
  [[ -f "$source" ]] || fail "Privacy policy source not found: $source"
  [[ -d "$policy_repo/.git" ]] || fail "Privacy Policies repository not found: $policy_repo"
  expected_url="https://asgarov1.github.io/Privacy-Policies/${published_path%.md}"
  [[ "$PRIVACY_URL" == "$expected_url" ]] || fail "PRIVACY_URL must be $expected_url for PRIVACY_POLICY_PUBLISHED_PATH=$published_path"
  source_name="${source##*/}"
  [[ "$source_name" == *.md ]] || fail "PRIVACY_POLICY_SOURCE must be a Markdown file: $source"
  git -C "$policy_repo" diff --quiet -- "$published_path" || fail "Privacy policy target has uncommitted changes: $policy_repo/$published_path"
  git -C "$policy_repo" diff --cached --quiet -- "$published_path" || fail "Privacy policy target has staged changes: $policy_repo/$published_path"
  mkdir -p "$(dirname "$policy_repo/$published_path")"
  if ! cmp -s "$source" "$policy_repo/$published_path"; then
    cp "$source" "$policy_repo/$published_path"
    git -C "$policy_repo" add -- "$published_path"
    git -C "$policy_repo" commit -m "Publish privacy policy for $APP_NAME" -- "$published_path"
    branch="$(git -C "$policy_repo" symbolic-ref --quiet --short HEAD)" || fail "Privacy Policies repository must be on a branch before publication"
    git -C "$policy_repo" push origin "$branch"
  fi
  curl --fail --silent --show-error --location --retry 6 --retry-delay 2 "$PRIVACY_URL" >/dev/null || fail "Privacy policy is not publicly reachable after publication: $PRIVACY_URL"
  printf 'Privacy policy is published and reachable: %s\n' "$PRIVACY_URL"
}

metadata_dir="$PROJECT_DIR/store-metadata/en-US"
mkdir -p "$metadata_dir"
write_metadata() { printf '%s\n' "$2" > "$metadata_dir/$1"; }
write_metadata name.txt "$APP_NAME"
write_metadata description.txt "$DESCRIPTION"
write_metadata keywords.txt "$KEYWORDS"
write_metadata release_notes.txt "$RELEASE_NOTES"
write_metadata support_url.txt "$SUPPORT_URL"
write_metadata privacy_url.txt "$PRIVACY_URL"
write_metadata copyright.txt "$COPYRIGHT"
[[ -n "${SUBTITLE:-}" ]] && write_metadata subtitle.txt "$SUBTITLE" || rm -f "$metadata_dir/subtitle.txt"
[[ -n "${PROMOTIONAL_TEXT:-}" ]] && write_metadata promotional_text.txt "$PROMOTIONAL_TEXT" || rm -f "$metadata_dir/promotional_text.txt"

# The bundled submit helper consumes this file. %q keeps spaces and punctuation
# source-safe without exposing credentials in command arguments.
submit_env="$PROJECT_DIR/.app-store-submit.env"
write_env() { printf '%s=%q\n' "$1" "$2" >> "$submit_env"; }
umask 077
: > "$submit_env"
for variable in APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE APPLE_ID FASTLANE_SESSION REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL PRIMARY_CATEGORY; do
  write_env "$variable" "${!variable}"
done
write_env REVIEW_NOTES "${REVIEW_NOTES:-No sign-in is required to use the app.}"
write_env METADATA_PATH store-metadata
write_env SCREENSHOT_PATHS "${SCREENSHOT_PATHS:-screenshots/iphone screenshots/ipad}"
write_env PREVIEW_PATH "${PREVIEW_PATH:-previews}"
write_env RUN_TESTS "${RUN_TESTS:-1}"
write_env TEST_DEVICE "${TEST_DEVICE:-iPhone 17 Pro Max}"
write_env BUILD_NUMBER "$BUILD_NUMBER"
write_env AUTOMATIC_RELEASE "${AUTOMATIC_RELEASE:-0}"
write_env USES_IDFA "$USES_IDFA"
write_env USES_NON_EXEMPT_ENCRYPTION "$USES_NON_EXEMPT_ENCRYPTION"
write_env CONTENT_RIGHTS_DECLARATION "$CONTENT_RIGHTS_DECLARATION"
write_env RELEASE_VERSION "$RELEASE_VERSION"

STATE_FILE="$PROJECT_DIR/.deploy-app-state"
privacy_policy_source="$(relative_path "$PRIVACY_POLICY_SOURCE")"
[[ -f "$privacy_policy_source" ]] || fail "Privacy policy source not found: $privacy_policy_source"
PRIVACY_POLICY_FINGERPRINT="$(shasum -a 256 "$privacy_policy_source" | awk '{print $1}')"
media_files=()
for source_dir in ${SCREENSHOT_PATHS:-screenshots/iphone screenshots/ipad}; do
  source_dir="$(relative_path "$source_dir")"
  [[ -d "$source_dir" ]] || continue
  while IFS= read -r -d '' media_file; do
    media_files+=("$media_file")
  done < <(find "$source_dir" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \) -print0)
done
preview_source="$(relative_path "${PREVIEW_PATH:-previews}")"
if [[ -d "$preview_source" ]]; then
  while IFS= read -r -d '' media_file; do
    media_files+=("$media_file")
  done < <(find "$preview_source" -maxdepth 1 -type f \( -iname '*.mp4' -o -iname '*.mov' -o -iname '*.m4v' \) -print0)
fi

MEDIA_FINGERPRINT="$({
  for media_file in "${media_files[@]:-}"; do
    [[ -n "$media_file" ]] || continue
    printf '%s\n' "${media_file#"$PROJECT_DIR/"}"
    shasum -a 256 "$media_file"
  done
} | LC_ALL=C sort | shasum -a 256 | awk '{print $1}')"
CONFIG_FINGERPRINT="$({
  shasum -a 256 "$DEPLOY_ENV"
  printf '%s\n' "$PRIVACY_POLICY_FINGERPRINT"
  printf '%s\n' "$MEDIA_FINGERPRINT"
} | shasum -a 256 | awk '{print $1}')"
DEPLOYMENT_ID="$APP_IDENTIFIER:$RELEASE_VERSION"
previous_deployment_id=""
previous_fingerprint=""
if [[ -f "$STATE_FILE" ]]; then
  previous_deployment_id="$(awk -F= '$1 == "DEPLOYMENT_ID" { print substr($0, index($0, "=") + 1) }' "$STATE_FILE")"
  previous_fingerprint="$(awk -F= '$1 == "CONFIG_FINGERPRINT" { print substr($0, index($0, "=") + 1) }' "$STATE_FILE")"
fi

if [[ "$dry_run" == 1 ]]; then
  "$SUBMISSION_SCRIPT" "$PROJECT_DIR" --dry-run
  printf 'Validated deployment configuration, metadata, screenshots, and previews in %s. Privacy-policy publication and Apple services were not contacted.\n' "$PROJECT_DIR"
  exit 0
fi

if [[ "$force" != 1 && "$previous_deployment_id" == "$DEPLOYMENT_ID" && "$previous_fingerprint" == "$CONFIG_FINGERPRINT" ]]; then
  printf 'Deployment %s already completed with this configuration; skipping. Use --force to run it again.\n' "$DEPLOYMENT_ID"
  exit 0
fi

publish_privacy_policy

command=("$SUBMISSION_SCRIPT" "$PROJECT_DIR" --create-app)
[[ "$release" == 1 ]] && command+=(--release)
[[ "$no_tests" == 1 ]] && command+=(--no-tests)
"${command[@]}"
umask 077
{
  printf 'DEPLOYMENT_ID=%s\n' "$DEPLOYMENT_ID"
  printf 'CONFIG_FINGERPRINT=%s\n' "$CONFIG_FINGERPRINT"
  printf 'COMPLETED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$STATE_FILE"
printf 'Deployment %s completed and recorded in %s.\n' "$DEPLOYMENT_ID" "$STATE_FILE"
