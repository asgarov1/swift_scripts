#!/usr/bin/env bash
# Prepare the complete first-release App Store Connect metadata, then delegate
# the archive/upload/submission to a project submission script.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE="$SCRIPT_DIR/deploy-app.env.example"
DEFAULTS_ENV="$SCRIPT_DIR/deploy-app.defaults.env"

usage() {
  cat <<'EOF'
Usage: deploy-app <app-project-path> [--configure] [--init] [--dry-run] [--submit] [--release] [--force]

The bundled Fastlane helper runs App Store precheck by default. Pass --submit
to archive, upload, and submit the app. Deployment does not run tests; run and
verify them before invoking this command.

On the first run, a missing .deploy-app.env is created by showing the resolved
defaults and asking whether to continue or edit. If an existing configuration
is missing a required value, only that value is requested and saved. Choosing
Edit walks through each value; --configure also opens that detailed editing flow. --init remains
available to create only the example file. The command creates the
app-store-submit configuration and Fastlane Deliver metadata before calling
the submission script. Before an App Store upload, it publishes the configured
privacy-policy Markdown file to the Privacy-Policies GitHub Pages repository
and verifies its public URL. A successful deployment is recorded locally and
is skipped on later runs when RELEASE_VERSION and the configuration are
unchanged. Use --force to deliberately run it again.
EOF
}

fail() { printf 'deploy-app: %s\n' "$*" >&2; exit 1; }

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac
[[ $# -ge 1 ]] || { usage >&2; exit 2; }
PROJECT_INPUT="$1"
PROJECT_DIR="$PROJECT_INPUT"
shift

SUBMISSION_SCRIPT="$SCRIPT_DIR/app-store-submit"
[[ -f "$SUBMISSION_SCRIPT" ]] || fail "Bundled submission script not found: $SUBMISSION_SCRIPT"
[[ -x "$SUBMISSION_SCRIPT" ]] || fail "Submission script is not executable: $SUBMISSION_SCRIPT"
[[ -f "$DEFAULTS_ENV" ]] || fail "Bundled defaults file not found: $DEFAULTS_ENV"
source "$DEFAULTS_ENV"
# App Store submission is API-key-only. Do not load legacy Fastlane web
# sessions from the secrets file: stale sessions can provoke Apple ID lockouts.
unset APPLE_ID FASTLANE_SESSION FASTLANE_PASSWORD FASTLANE_USER
PROJECT_DIR="$(cd "$PROJECT_DIR" 2>/dev/null && pwd)" || fail "Project directory not found: $PROJECT_INPUT"

init=0
dry_run=0
release=0
submit=0
no_tests=0
force=0
configure=0
for argument in "$@"; do
  case "$argument" in
    --configure) configure=1 ;;
    --init) init=1 ;;
    --dry-run) dry_run=1 ;;
    --submit) submit=1 ;;
    --release) release=1 ;;
    --no-tests) no_tests=1 ;;
    --force) force=1 ;;
    --help|-h) usage; exit 0 ;;
    *) fail "Unknown argument: $argument" ;;
  esac
done
[[ "$release" == 0 || "$submit" == 1 ]] || fail "--release requires --submit"

DEPLOY_ENV="$PROJECT_DIR/.deploy-app.env"
DEPLOY_ENV_MISSING_VARIABLES=""
if [[ "$init" == 1 ]]; then
  if [[ -e "$PROJECT_DIR/.deploy-app.env.example" ]]; then
    printf 'Keeping existing %s.\n' "$PROJECT_DIR/.deploy-app.env.example"
  else
    cp "$TEMPLATE" "$PROJECT_DIR/.deploy-app.env.example"
    printf 'Created %s.\n' "$PROJECT_DIR/.deploy-app.env.example"
  fi
  mkdir -p "$PROJECT_DIR/store-metadata/en-US"
  [[ -e "$DEPLOY_ENV" ]] && printf 'Keeping existing %s.\n' "$DEPLOY_ENV" || printf 'Run deploy-app normally to create %s interactively.\n' "$DEPLOY_ENV"
  exit 0
fi

find_privacy_policies_repo() {
  local candidate="$PROJECT_DIR"
  while [[ "$candidate" != / ]]; do
    if [[ -d "$candidate/Privacy-Policies/.git" ]]; then
      printf '%s\n' "$candidate/Privacy-Policies"
      return
    fi
    candidate="$(dirname "$candidate")"
  done
}

migrate_legacy_privacy_policy_slug() {
  local project_slug legacy_path current_path legacy_url current_url
  project_slug="$(basename "$PROJECT_DIR" | tr '-' '_')"
  legacy_path="${project_slug}_privacyPolicy.md"
  current_path="${project_slug}_privacy_policy.md"
  legacy_url="https://asgarov1.github.io/Privacy-Policies/${legacy_path%.md}"
  current_url="https://asgarov1.github.io/Privacy-Policies/${current_path%.md}"
  if [[ "${PRIVACY_POLICY_PUBLISHED_PATH:-}" == "$legacy_path" ]]; then
    PRIVACY_POLICY_PUBLISHED_PATH="$current_path"
  fi
  if [[ "${PRIVACY_URL:-}" == "$legacy_url" ]]; then
    PRIVACY_URL="$current_url"
  fi
}

project_value() {
  local key="$1"
  local project_file
  project_file="$(find "$PROJECT_DIR" -maxdepth 2 -name project.pbxproj -path '*.xcodeproj/project.pbxproj' -print -quit)"
  [[ -n "$project_file" ]] || return
  awk -v key="$key" '
    $0 ~ "^[[:space:]]*" key " = " {
      value = $0
      sub("^[[:space:]]*" key " = ", "", value)
      sub(";[[:space:]]*$", "", value)
      gsub(/\"/, "", value)
      if (value !~ /Tests$/) { print value; exit }
    }
  ' "$project_file"
}

app_config_value() {
  local pattern="$1"
  local source
  source="$(rg -l -m1 'AppConfig\(' "$PROJECT_DIR" --glob '*.swift' | head -1 || true)"
  [[ -n "$source" ]] || return
  sed -nE "$pattern" "$source" | head -1
}

prompt_value() {
  local variable="$1" label="$2" default_value="$3" required="$4" secret="${5:-0}"
  local response prompt
  if [[ "${prompt_all_values:-0}" != 1 ]] && ! deploy_env_value_is_missing "$variable"; then
    return
  fi
  while :; do
    prompt="$label"
    [[ -n "$default_value" ]] && prompt+=" [$default_value]"
    prompt+=": "
    if [[ "$secret" == 1 ]]; then
      read -r -s -p "$prompt" response < /dev/tty
      printf '\n' > /dev/tty
    else
      read -r -p "$prompt" response < /dev/tty
    fi
    response="${response:-$default_value}"
    if [[ "$required" == 0 || -n "$response" ]]; then
      printf -v "$variable" '%s' "$response"
      return
    fi
    printf '%s is required.\n' "$label" > /dev/tty
  done
}

deploy_env_declares_variable() {
  local variable="$1"
  rg -q "^[[:space:]]*(export[[:space:]]+)?${variable}=" "$DEPLOY_ENV"
}

deploy_env_value_is_missing() {
  [[ "|$DEPLOY_ENV_MISSING_VARIABLES|" == *"|$1|"* ]]
}

record_missing_deploy_env_values() {
  local variable
  DEPLOY_ENV_MISSING_VARIABLES=""
  for variable in APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL REVIEW_NOTES PRIMARY_CATEGORY COPYRIGHT SUPPORT_URL LANGUAGE_NAME LANGUAGE_LEVEL PRIVACY_URL SUBTITLE DESCRIPTION KEYWORDS PROMOTIONAL_TEXT RELEASE_NOTES PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH CONTENT_RIGHTS_DECLARATION USES_IDFA USES_NON_EXEMPT_ENCRYPTION SCREENSHOT_PATHS SKIP_SCREENSHOTS_IF_UNCHANGED PREVIEW_PATH RUN_TESTS TEST_DEVICE BUILD_NUMBER AUTOMATIC_RELEASE RELEASE_VERSION; do
    # Defaults are for first-run setup only. Do not silently restore a value
    # the user removed from an existing project configuration.
    if ! deploy_env_declares_variable "$variable"; then
      DEPLOY_ENV_MISSING_VARIABLES+="|$variable"
      unset "$variable"
    fi
  done
}

show_setup_defaults() {
  local variable
  printf '\nDeployment configuration defaults:\n' > /dev/tty
  for variable in APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL REVIEW_NOTES PRIMARY_CATEGORY COPYRIGHT SUPPORT_URL LANGUAGE_NAME LANGUAGE_LEVEL PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH PRIVACY_URL SUBTITLE DESCRIPTION KEYWORDS PROMOTIONAL_TEXT RELEASE_NOTES CONTENT_RIGHTS_DECLARATION USES_IDFA USES_NON_EXEMPT_ENCRYPTION SCREENSHOT_PATHS SKIP_SCREENSHOTS_IF_UNCHANGED PREVIEW_PATH RUN_TESTS TEST_DEVICE BUILD_NUMBER AUTOMATIC_RELEASE RELEASE_VERSION; do
    printf '  %-31s %s\n' "$variable" "${!variable:-<not set>}" > /dev/tty
  done
  printf '\n' > /dev/tty
}

choose_setup_action() {
  local response
  while :; do
    read -r -p 'Continue with these values or edit them one by one? [C/e]: ' response < /dev/tty
    case "${response:-c}" in
      c|C|continue|Continue)
        if config_needs_answers; then
          printf 'Some required values are not set. Choose E to provide them.\n' > /dev/tty
        else
          prompt_all_values=0
          return
        fi
        ;;
      e|E|edit|Edit) prompt_all_values=1; return ;;
      *) printf 'Enter C to continue or E to edit.\n' > /dev/tty ;;
    esac
  done
}

ensure_secret_files_ignored() {
  local ignore_file entry
  ignore_file="$PROJECT_DIR/.gitignore"
  for entry in '.deploy-app.env' '.app-store-submit.env' '.deploy-app-state'; do
    rg -qxF "$entry" "$ignore_file" 2>/dev/null || printf '%s\n' "$entry" >> "$ignore_file"
  done
}

write_deploy_env() {
  local variable
  umask 077
  {
    printf '# Generated by deploy-app. This file contains credentials; do not commit it.\n'
    for variable in APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL REVIEW_NOTES PRIMARY_CATEGORY COPYRIGHT SUPPORT_URL LANGUAGE_NAME LANGUAGE_LEVEL PRIVACY_URL SUBTITLE DESCRIPTION KEYWORDS PROMOTIONAL_TEXT RELEASE_NOTES PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH CONTENT_RIGHTS_DECLARATION USES_IDFA USES_NON_EXEMPT_ENCRYPTION SCREENSHOT_PATHS SKIP_SCREENSHOTS_IF_UNCHANGED PREVIEW_PATH RUN_TESTS TEST_DEVICE BUILD_NUMBER AUTOMATIC_RELEASE RELEASE_VERSION; do
      printf '%s=%q\n' "$variable" "${!variable}"
    done
    for variable in PRICE_TIER AVAILABLE_IN_ALL_TERRITORIES AGE_RATING_ALCOHOL_TOBACCO_OR_DRUG_USE_OR_REFERENCES AGE_RATING_CONTESTS AGE_RATING_GAMBLING_SIMULATED AGE_RATING_GUNS_OR_OTHER_WEAPONS AGE_RATING_HORROR_OR_FEAR_THEMES AGE_RATING_MATURE_OR_SUGGESTIVE_THEMES AGE_RATING_MEDICAL_OR_TREATMENT_INFORMATION AGE_RATING_PROFANITY_OR_CRUDE_HUMOR AGE_RATING_SEXUAL_CONTENT_GRAPHIC_AND_NUDITY AGE_RATING_SEXUAL_CONTENT_OR_NUDITY AGE_RATING_VIOLENCE_CARTOON_OR_FANTASY AGE_RATING_VIOLENCE_REALISTIC_PROLONGED_GRAPHIC_OR_SADISTIC AGE_RATING_VIOLENCE_REALISTIC AGE_RATING_ADVERTISING AGE_RATING_AGE_ASSURANCE AGE_RATING_GAMBLING AGE_RATING_HEALTH_OR_WELLNESS_TOPICS AGE_RATING_LOOT_BOX AGE_RATING_MESSAGING_AND_CHAT AGE_RATING_PARENTAL_CONTROLS AGE_RATING_SOCIAL_MEDIA AGE_RATING_SOCIAL_MEDIA_AGE_RESTRICTED AGE_RATING_UNRESTRICTED_WEB_ACCESS AGE_RATING_USER_GENERATED_CONTENT; do
      printf '%s=%q\n' "$variable" "${!variable}"
    done
    for variable in IAP_CREATE_DEFAULTS IAP_SUBSCRIPTION_GROUP_NAME IAP_MONTHLY_REFERENCE_NAME IAP_MONTHLY_PRODUCT_ID IAP_MONTHLY_PRICE_USD IAP_QUARTERLY_REFERENCE_NAME IAP_QUARTERLY_PRODUCT_ID IAP_QUARTERLY_PRICE_USD IAP_LIFETIME_REFERENCE_NAME IAP_LIFETIME_PRODUCT_ID IAP_LIFETIME_PRICE_USD; do
      printf '%s=%q\n' "$variable" "${!variable}"
    done
  } > "$DEPLOY_ENV"
  ensure_secret_files_ignored
  printf 'Created %s. Future runs preserve it without prompting.\n' "$DEPLOY_ENV"
}

interactive_setup() {
  local xcodeproj scheme identifier app_name language language_level privacy_source privacy_repo policy_slug privacy_url copyright_owner build_number
  [[ -t 0 && -r /dev/tty ]] || fail "Missing $DEPLOY_ENV and no interactive terminal is available. Create it from .deploy-app.env.example."
  [[ -e "$PROJECT_DIR/.deploy-app.env.example" ]] || cp "$TEMPLATE" "$PROJECT_DIR/.deploy-app.env.example"
  mkdir -p "$PROJECT_DIR/store-metadata/en-US"

  xcodeproj="$(basename "$(find "$PROJECT_DIR" -maxdepth 1 -type d -name '*.xcodeproj' -print -quit)")"
  scheme="${xcodeproj%.xcodeproj}"
  identifier="$(project_value PRODUCT_BUNDLE_IDENTIFIER)"
  app_name="$(app_config_value 's/.*appName:[[:space:]]*"([^"]+)".*/\1/p')"
  language="$(app_config_value 's/.*learningLanguage:[[:space:]]*\.([[:alpha:]]+).*/\1/p')"
  [[ -n "$language" ]] && language="$(printf '%s' "$language" | awk '{ print toupper(substr($0, 1, 1)) substr($0, 2) }')"
  language_level="$(app_config_value 's/.*certificateLevel:[[:space:]]*"([^"]+)".*/\1/p')"
  privacy_source="$(find "$PROJECT_DIR" -maxdepth 1 -type f -iname '*privacy*.md' -print -quit)"
  privacy_source="${privacy_source#"$PROJECT_DIR/"}"
  privacy_repo="$(find_privacy_policies_repo || true)"
  policy_slug="$(basename "$PROJECT_DIR" | tr '-' '_')_privacy_policy.md"
  privacy_url="https://asgarov1.github.io/Privacy-Policies/${policy_slug%.md}"
  copyright_owner="$(git config --get user.name 2>/dev/null || true)"
  build_number="$(project_value CURRENT_PROJECT_VERSION)"

  # Resolve every value before presenting the first-run review. This lets the
  # common path create a configuration without making the user re-accept each
  # value, while retaining the detailed editing flow when it is needed.
  : "${APP_IDENTIFIER:=$identifier}"
  : "${APP_NAME:=${app_name:-$scheme}}"
  : "${APP_SKU:=${identifier:-$scheme}}"
  : "${SCHEME:=$scheme}"
  : "${XCODEPROJ:=$xcodeproj}"
  : "${REVIEW_NOTES:=No sign-in is required to use the app.}"
  : "${PRIMARY_CATEGORY:=Education}"
  : "${COPYRIGHT:=$(date +%Y) ${copyright_owner:-Your Company}}"
  : "${PRICE_TIER:=0}"
  : "${AVAILABLE_IN_ALL_TERRITORIES:=1}"
  : "${IAP_CREATE_DEFAULTS:=1}"
  : "${IAP_SUBSCRIPTION_GROUP_NAME:=Premium Access}"
  : "${IAP_MONTHLY_REFERENCE_NAME:=Monthly Subscription}"
  : "${IAP_MONTHLY_PRODUCT_ID:=${APP_IDENTIFIER}.premium}"
  : "${IAP_MONTHLY_PRICE_USD:=6.99}"
  : "${IAP_QUARTERLY_REFERENCE_NAME:=Quarterly (3 months) Subscription}"
  : "${IAP_QUARTERLY_PRODUCT_ID:=${APP_IDENTIFIER}.premium.3months}"
  : "${IAP_QUARTERLY_PRICE_USD:=14.99}"
  : "${IAP_LIFETIME_REFERENCE_NAME:=Lifetime Access}"
  : "${IAP_LIFETIME_PRODUCT_ID:=${APP_IDENTIFIER}.premium.lifetime}"
  : "${IAP_LIFETIME_PRICE_USD:=44.99}"
  : "${LANGUAGE_NAME:=$language}"
  : "${LANGUAGE_LEVEL:=$language_level}"
  : "${PRIVACY_POLICY_SOURCE:=$privacy_source}"
  : "${PRIVACY_POLICIES_REPO:=$privacy_repo}"
  : "${PRIVACY_POLICY_PUBLISHED_PATH:=$policy_slug}"
  privacy_url="https://asgarov1.github.io/Privacy-Policies/${PRIVACY_POLICY_PUBLISHED_PATH%.md}"
  : "${PRIVACY_URL:=$privacy_url}"
  : "${RELEASE_NOTES:=Initial release.}"
  case "${CONTENT_RIGHTS_DECLARATION:-}" in
    owns|third-party) ;;
    *) CONTENT_RIGHTS_DECLARATION=owns ;;
  esac
  : "${USES_IDFA:=0}"
  : "${USES_NON_EXEMPT_ENCRYPTION:=0}"
  : "${SCREENSHOT_PATHS:=screenshots/iphone screenshots/ipad}"
  : "${SKIP_SCREENSHOTS_IF_UNCHANGED:=1}"
  : "${PREVIEW_PATH:=previews}"
  : "${RUN_TESTS:=1}"
  : "${TEST_DEVICE:=iPhone 17 Pro Max}"
  : "${BUILD_NUMBER:=$build_number}"
  : "${AUTOMATIC_RELEASE:=0}"
  : "${RELEASE_VERSION:=$(project_value MARKETING_VERSION)}"

  prompt_all_values="$configure"
  if [[ "${prompt_missing_values:-0}" == 1 ]]; then
    printf 'Deployment configuration is missing required values. Enter the requested values to update %s.\n' "$DEPLOY_ENV" > /dev/tty
  elif [[ "$configure" != 1 ]]; then
    printf 'No deployment configuration found. Review the inferred and shared defaults below.\n' > /dev/tty
    show_setup_defaults
    choose_setup_action
  else
    printf 'Editing deployment configuration; press Enter to keep each value in brackets.\n' > /dev/tty
  fi

  prompt_value APP_IDENTIFIER 'Bundle identifier' "${APP_IDENTIFIER:-$identifier}" 1
  prompt_value APP_NAME 'App Store name' "${APP_NAME:-${app_name:-$scheme}}" 1
  prompt_value APP_SKU 'App Store SKU' "${APP_SKU:-${identifier:-$scheme}}" 1
  prompt_value SCHEME 'Xcode scheme' "${SCHEME:-$scheme}" 1
  prompt_value XCODEPROJ 'Xcode project' "${XCODEPROJ:-$xcodeproj}" 1
  prompt_value ASC_KEY_ID 'App Store Connect API key ID' "${ASC_KEY_ID:-}" 1
  prompt_value ASC_ISSUER_ID 'App Store Connect issuer ID' "${ASC_ISSUER_ID:-}" 1
  prompt_value ASC_KEY_FILE 'App Store Connect API key .p8 path' "${ASC_KEY_FILE:-}" 1
  prompt_value REVIEW_CONTACT_FIRST_NAME 'App Review contact first name' "${REVIEW_CONTACT_FIRST_NAME:-}" 1
  prompt_value REVIEW_CONTACT_LAST_NAME 'App Review contact last name' "${REVIEW_CONTACT_LAST_NAME:-}" 1
  prompt_value REVIEW_CONTACT_PHONE 'App Review contact phone' "${REVIEW_CONTACT_PHONE:-}" 1
  prompt_value REVIEW_CONTACT_EMAIL 'App Review contact email' "${REVIEW_CONTACT_EMAIL:-}" 1
  prompt_value REVIEW_NOTES 'App Review notes' "${REVIEW_NOTES:-No sign-in is required to use the app.}" 1
  prompt_value PRIMARY_CATEGORY 'Primary category' "${PRIMARY_CATEGORY:-Education}" 1
  prompt_value COPYRIGHT 'Copyright' "${COPYRIGHT:-$(date +%Y) ${copyright_owner:-Your Company}}" 1
  prompt_value PRICE_TIER 'App Store price tier (0 is free)' "${PRICE_TIER:-0}" 1
  prompt_value AVAILABLE_IN_ALL_TERRITORIES 'Available in all App Store territories: 0 or 1' "${AVAILABLE_IN_ALL_TERRITORIES:-1}" 1
  prompt_value SUPPORT_URL 'Support URL' "${SUPPORT_URL:-}" 1
  prompt_value LANGUAGE_NAME 'Learning language (leave blank for a non-language app)' "${LANGUAGE_NAME:-$language}" 0
  prompt_value LANGUAGE_LEVEL 'Learning level (leave blank for a non-language app)' "${LANGUAGE_LEVEL:-$language_level}" 0
  prompt_value PRIVACY_POLICY_SOURCE 'Privacy-policy source file' "${PRIVACY_POLICY_SOURCE:-$privacy_source}" 1
  prompt_value PRIVACY_POLICIES_REPO 'Privacy Policies repository' "${PRIVACY_POLICIES_REPO:-$privacy_repo}" 1
  prompt_value PRIVACY_POLICY_PUBLISHED_PATH 'Published privacy-policy path' "${PRIVACY_POLICY_PUBLISHED_PATH:-$policy_slug}" 1
  privacy_url="https://asgarov1.github.io/Privacy-Policies/${PRIVACY_POLICY_PUBLISHED_PATH%.md}"
  prompt_value PRIVACY_URL 'Privacy-policy URL' "${PRIVACY_URL:-$privacy_url}" 1
  prompt_value SUBTITLE 'Subtitle (optional)' "${SUBTITLE:-}" 0
  local copy_required=0
  [[ -z "$LANGUAGE_NAME" && -z "$LANGUAGE_LEVEL" ]] && copy_required=1
  prompt_value DESCRIPTION 'Description (optional for language apps)' "${DESCRIPTION:-}" "$copy_required"
  prompt_value KEYWORDS 'Keywords (optional for language apps)' "${KEYWORDS:-}" "$copy_required"
  prompt_value PROMOTIONAL_TEXT 'Promotional text (optional)' "${PROMOTIONAL_TEXT:-}" 0
  prompt_value RELEASE_NOTES 'Release notes' "${RELEASE_NOTES:-Initial release.}" 1
  case "${CONTENT_RIGHTS_DECLARATION:-}" in
    owns|third-party) ;;
    *) CONTENT_RIGHTS_DECLARATION="" ;;
  esac
  prompt_value CONTENT_RIGHTS_DECLARATION 'Content rights: owns or third-party' "${CONTENT_RIGHTS_DECLARATION:-owns}" 1
  prompt_value USES_IDFA 'Uses advertising identifier: 0 or 1' "${USES_IDFA:-0}" 1
  prompt_value USES_NON_EXEMPT_ENCRYPTION 'Uses non-exempt encryption: 0 or 1' "${USES_NON_EXEMPT_ENCRYPTION:-0}" 1
  prompt_value SCREENSHOT_PATHS 'Screenshot paths' "${SCREENSHOT_PATHS:-screenshots/iphone screenshots/ipad}" 1
  prompt_value PREVIEW_PATH 'App Preview path' "${PREVIEW_PATH:-previews}" 1
  prompt_value RUN_TESTS 'Run tests: 0 or 1' "${RUN_TESTS:-1}" 1
  prompt_value TEST_DEVICE 'Test device' "${TEST_DEVICE:-iPhone 17 Pro Max}" 1
  prompt_value BUILD_NUMBER 'Build number (kept fixed across retries)' "${BUILD_NUMBER:-$build_number}" 1
  prompt_value AUTOMATIC_RELEASE 'Release automatically after approval: 0 or 1' "${AUTOMATIC_RELEASE:-0}" 1
  prompt_value RELEASE_VERSION 'App Store version' "${RELEASE_VERSION:-$(project_value MARKETING_VERSION)}" 1
  write_deploy_env
}

if [[ -f "$DEPLOY_ENV" ]]; then
  record_missing_deploy_env_values
  set -a
  # shellcheck disable=SC1090
  source "$DEPLOY_ENV"
  set +a
fi
migrate_legacy_privacy_policy_slug
# Promotional text is always supplied to Fastlane. Projects may replace this
# shared message with app-specific copy, but an empty legacy value uses it.
: "${PROMOTIONAL_TEXT:=No account, no registration, fully offline app - ideal for learning on the go!}"
unset APPLE_ID FASTLANE_SESSION FASTLANE_PASSWORD FASTLANE_USER
config_needs_answers() {
  local variable
  case "${CONTENT_RIGHTS_DECLARATION:-}" in
    owns|third-party) ;;
    *) return 0 ;;
  esac
  for variable in APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL REVIEW_NOTES PRIMARY_CATEGORY COPYRIGHT SUPPORT_URL PRIVACY_URL RELEASE_NOTES PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH CONTENT_RIGHTS_DECLARATION PRICE_TIER AVAILABLE_IN_ALL_TERRITORIES USES_IDFA USES_NON_EXEMPT_ENCRYPTION RUN_TESTS AUTOMATIC_RELEASE BUILD_NUMBER RELEASE_VERSION; do
    [[ -n "${!variable:-}" ]] || return 0
  done
  if [[ -z "${LANGUAGE_NAME:-}" && -z "${LANGUAGE_LEVEL:-}" ]]; then
    [[ -n "${DESCRIPTION:-}" && -n "${KEYWORDS:-}" ]] || return 0
  fi
  return 1
}

prompt_missing_values=0
if [[ -f "$DEPLOY_ENV" && "$configure" != 1 ]] && config_needs_answers; then
  prompt_missing_values=1
fi
if [[ ! -f "$DEPLOY_ENV" || "$configure" == 1 ]] || config_needs_answers; then
  interactive_setup
fi
set -a
# shellcheck disable=SC1090
source "$DEPLOY_ENV"
set +a
migrate_legacy_privacy_policy_slug
: "${PROMOTIONAL_TEXT:=No account, no registration, fully offline app - ideal for learning on the go!}"
: "${IAP_CREATE_DEFAULTS:=1}"
: "${IAP_SUBSCRIPTION_GROUP_NAME:=Premium Access}"
: "${IAP_MONTHLY_REFERENCE_NAME:=Monthly Subscription}"
: "${IAP_MONTHLY_PRODUCT_ID:=${APP_IDENTIFIER}.premium}"
: "${IAP_MONTHLY_PRICE_USD:=6.99}"
: "${IAP_QUARTERLY_REFERENCE_NAME:=Quarterly (3 months) Subscription}"
: "${IAP_QUARTERLY_PRODUCT_ID:=${APP_IDENTIFIER}.premium.3months}"
: "${IAP_QUARTERLY_PRICE_USD:=14.99}"
: "${IAP_LIFETIME_REFERENCE_NAME:=Lifetime Access}"
: "${IAP_LIFETIME_PRODUCT_ID:=${APP_IDENTIFIER}.premium.lifetime}"
: "${IAP_LIFETIME_PRICE_USD:=44.99}"
unset APPLE_ID FASTLANE_SESSION FASTLANE_PASSWORD FASTLANE_USER

required=(
  APP_IDENTIFIER APP_NAME APP_SKU SCHEME XCODEPROJ ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_FILE
  REVIEW_CONTACT_FIRST_NAME REVIEW_CONTACT_LAST_NAME
  REVIEW_CONTACT_PHONE REVIEW_CONTACT_EMAIL PRIMARY_CATEGORY COPYRIGHT
  SUPPORT_URL PRIVACY_URL RELEASE_NOTES
  PRIVACY_POLICY_SOURCE PRIVACY_POLICIES_REPO PRIVACY_POLICY_PUBLISHED_PATH
  CONTENT_RIGHTS_DECLARATION PRICE_TIER AVAILABLE_IN_ALL_TERRITORIES USES_IDFA USES_NON_EXEMPT_ENCRYPTION BUILD_NUMBER RELEASE_VERSION
)
for variable in "${required[@]}"; do
  [[ -n "${!variable:-}" ]] || fail "Missing $variable in $DEPLOY_ENV"
done

case "$USES_IDFA" in 0|1) ;; *) fail "USES_IDFA must be 0 or 1" ;; esac
case "$USES_NON_EXEMPT_ENCRYPTION" in 0|1) ;; *) fail "USES_NON_EXEMPT_ENCRYPTION must be 0 or 1" ;; esac
case "$RUN_TESTS" in 0|1) ;; *) fail "RUN_TESTS must be 0 or 1" ;; esac
case "$AUTOMATIC_RELEASE" in 0|1) ;; *) fail "AUTOMATIC_RELEASE must be 0 or 1" ;; esac
case "${SKIP_SCREENSHOTS_IF_UNCHANGED:-1}" in 0|1) ;; *) fail "SKIP_SCREENSHOTS_IF_UNCHANGED must be 0 or 1" ;; esac
case "$AVAILABLE_IN_ALL_TERRITORIES" in 0|1) ;; *) fail "AVAILABLE_IN_ALL_TERRITORIES must be 0 or 1" ;; esac
case "$IAP_CREATE_DEFAULTS" in 0|1) ;; *) fail "IAP_CREATE_DEFAULTS must be 0 or 1" ;; esac
[[ "$PRICE_TIER" =~ ^[0-9]+$ ]] || fail "PRICE_TIER must be a non-negative integer"
if [[ "$IAP_CREATE_DEFAULTS" == 1 ]]; then
  for variable in IAP_SUBSCRIPTION_GROUP_NAME IAP_MONTHLY_REFERENCE_NAME IAP_MONTHLY_PRODUCT_ID IAP_MONTHLY_PRICE_USD IAP_QUARTERLY_REFERENCE_NAME IAP_QUARTERLY_PRODUCT_ID IAP_QUARTERLY_PRICE_USD IAP_LIFETIME_REFERENCE_NAME IAP_LIFETIME_PRODUCT_ID; do
    [[ -n "${!variable:-}" ]] || fail "Missing $variable when IAP_CREATE_DEFAULTS=1"
  done
  [[ "$IAP_MONTHLY_PRODUCT_ID" != "$IAP_QUARTERLY_PRODUCT_ID" && "$IAP_MONTHLY_PRODUCT_ID" != "$IAP_LIFETIME_PRODUCT_ID" && "$IAP_QUARTERLY_PRODUCT_ID" != "$IAP_LIFETIME_PRODUCT_ID" ]] || fail "Default in-app purchase product IDs must be unique"
  for variable in IAP_MONTHLY_PRICE_USD IAP_QUARTERLY_PRICE_USD; do
    [[ "${!variable}" =~ ^[0-9]+([.][0-9]{1,2})?$ ]] || fail "$variable must be a non-negative USD amount"
  done
  [[ -z "$IAP_LIFETIME_PRICE_USD" || "$IAP_LIFETIME_PRICE_USD" =~ ^[0-9]+([.][0-9]{1,2})?$ ]] || fail "IAP_LIFETIME_PRICE_USD must be a non-negative USD amount"
fi
[[ "$BUILD_NUMBER" =~ ^[1-9][0-9]*$ ]] || fail "BUILD_NUMBER must be a positive integer"
copyright_year="$(printf '%s' "$COPYRIGHT" | rg -o '[0-9]{4}' | head -1 || true)"
[[ -n "$copyright_year" ]] || fail "COPYRIGHT must include a four-digit year"
[[ "$copyright_year" -le "$(date +%Y)" ]] || fail "COPYRIGHT cannot use a future year: $copyright_year"
[[ "$SUPPORT_URL" =~ ^https:// ]] || fail "SUPPORT_URL must begin with https://"
[[ "$PRIVACY_URL" =~ ^https:// ]] || fail "PRIVACY_URL must begin with https://"
[[ "$CONTENT_RIGHTS_DECLARATION" == "owns" || "$CONTENT_RIGHTS_DECLARATION" == "third-party" ]] || fail "CONTENT_RIGHTS_DECLARATION must be owns or third-party"

if [[ -n "${LANGUAGE_NAME:-}" || -n "${LANGUAGE_LEVEL:-}" ]]; then
  [[ -n "${LANGUAGE_NAME:-}" && -n "${LANGUAGE_LEVEL:-}" ]] || fail "Set both LANGUAGE_NAME and LANGUAGE_LEVEL, or neither"
  language_lower="$(printf '%s' "$LANGUAGE_NAME" | tr '[:upper:]' '[:lower:]')"
  level_lower="$(printf '%s' "$LANGUAGE_LEVEL" | tr '[:upper:]' '[:lower:]')"
  case "$language_lower" in
    japanese) exam_keyword="jlpt" ;;
    korean) exam_keyword="topik" ;;
    *) exam_keyword="" ;;
  esac
  DESCRIPTION="${DESCRIPTION:-Jlingo $LANGUAGE_NAME $LANGUAGE_LEVEL is an offline study companion for learners building practical $LANGUAGE_NAME skills at the $LANGUAGE_LEVEL level.

Five complete learning modules help you build confidence at this level: verb forms and conjugation practice, flashcard-based $LANGUAGE_LEVEL vocabulary, grammar explained in clear English with useful examples, everyday phrases for real situations, and a quiz to check your knowledge and track your progress.

The app works entirely offline — no account, no ads, and no tracking. Your learning stays on your device.

Every module includes free sample content. Unlock the full course with an in-app subscription or lifetime purchase.

Earn a Certificate of Completion* by completing more than 80% of the course and scoring over 80% in the quiz.

Terms of Use: https://www.apple.com/legal/internet-services/itunes/dev/stdeula/

*The Certificate of Completion is not an official accreditation. It confirms that you have covered the learning material provided in the app.}"
  if [[ -n "$exam_keyword" ]]; then
    default_keywords="learn,$language_lower,$exam_keyword,$level_lower,grammar,verbs,phrases,flashcards,vocabulary,language,conjugation,quiz"
  else
    default_keywords="learn,$language_lower,$level_lower,grammar,verbs,phrases,flashcards,vocabulary,language,conjugation,quiz"
  fi
  KEYWORDS="${KEYWORDS:-$default_keywords}"
fi
[[ -n "${DESCRIPTION:-}" ]] || fail "Missing DESCRIPTION in $DEPLOY_ENV (or set LANGUAGE_NAME and LANGUAGE_LEVEL for the Jlingo default)"
[[ -n "${KEYWORDS:-}" ]] || fail "Missing KEYWORDS in $DEPLOY_ENV (or set LANGUAGE_NAME and LANGUAGE_LEVEL for the Jlingo default)"
SUBTITLE="${SUBTITLE:-}"
PROMOTIONAL_TEXT="${PROMOTIONAL_TEXT:-No account, no registration, fully offline app - ideal for learning on the go!}"
[[ ${#SUBTITLE} -le 30 ]] || fail "SUBTITLE exceeds App Store Connect's 30-character limit"
[[ ${#DESCRIPTION} -le 4000 ]] || fail "DESCRIPTION exceeds App Store Connect's 4,000-character limit"
[[ ${#KEYWORDS} -le 100 ]] || fail "KEYWORDS exceeds App Store Connect's 100-character limit"
[[ ${#PROMOTIONAL_TEXT} -le 170 ]] || fail "PROMOTIONAL_TEXT exceeds App Store Connect's 170-character limit"

relative_path() {
  case "$1" in
    /*) printf '%s\n' "$1" ;;
    *) printf '%s/%s\n' "$PROJECT_DIR" "$1" ;;
  esac
}

publish_privacy_policy() {
  local source policy_repo published_path expected_url source_name
  source="$(relative_path "$PRIVACY_POLICY_SOURCE")"
  policy_repo="$PRIVACY_POLICIES_REPO"
  [[ "$policy_repo" = /* ]] || policy_repo="$(relative_path "$policy_repo")"
  published_path="$PRIVACY_POLICY_PUBLISHED_PATH"
  [[ "$published_path" != /* && "$published_path" != *".."* ]] || fail "PRIVACY_POLICY_PUBLISHED_PATH must be a repository-relative path without .."
  [[ "$published_path" == *.md ]] || fail "PRIVACY_POLICY_PUBLISHED_PATH must name a Markdown file ending in .md"
  [[ -f "$source" ]] || fail "Privacy policy source not found: $source"
  [[ -d "$policy_repo/.git" ]] || fail "Privacy Policies repository not found: $policy_repo"
  expected_url="https://asgarov1.github.io/Privacy-Policies/${published_path%.md}"
  [[ "$PRIVACY_URL" == "$expected_url" ]] || fail "PRIVACY_URL must be $expected_url for PRIVACY_POLICY_PUBLISHED_PATH=$published_path"
  source_name="${source##*/}"
  [[ "$source_name" == *.md ]] || fail "PRIVACY_POLICY_SOURCE must be a Markdown file: $source"
  git -C "$policy_repo" diff --quiet -- "$published_path" || fail "Privacy policy target has uncommitted changes: $policy_repo/$published_path"
  git -C "$policy_repo" diff --cached --quiet -- "$published_path" || fail "Privacy policy target has staged changes: $policy_repo/$published_path"
  mkdir -p "$(dirname "$policy_repo/$published_path")"
  if ! cmp -s "$source" "$policy_repo/$published_path"; then
    cp "$source" "$policy_repo/$published_path"
    git -C "$policy_repo" add -- "$published_path"
    git -C "$policy_repo" commit -m "Publish privacy policy for $APP_NAME" -- "$published_path"
    branch="$(git -C "$policy_repo" symbolic-ref --quiet --short HEAD)" || fail "Privacy Policies repository must be on a branch before publication"
    git -C "$policy_repo" push origin "$branch"
  fi
  curl --fail --silent --show-error --location --retry 6 --retry-delay 2 "$PRIVACY_URL" >/dev/null || fail "Privacy policy is not publicly reachable after publication: $PRIVACY_URL"
  printf 'Privacy policy is published and reachable: %s\n' "$PRIVACY_URL"
}

# Language apps keep their translations in a compact JSON source file. Deliver
# does not read that format: it discovers localized metadata only from one
# directory per App Store locale. Expand the source before invoking Fastlane so
# a default (precheck-only) run and a submission run behave identically.
stage_json_metadata_localizations() {
  local localizations_file locale json_field metadata_file value locale_dir
  localizations_file="$PROJECT_DIR/store-metadata/localizations.json"
  [[ -f "$localizations_file" ]] || return
  command -v jq >/dev/null 2>&1 || fail "jq is required to stage $localizations_file"
  jq -e 'type == "object" and all(.[]; type == "object" and (.appInformation | type == "object"))' "$localizations_file" >/dev/null \
    || fail "Invalid localization source: $localizations_file (each locale needs an appInformation object)"

  while IFS= read -r locale; do
    [[ "$locale" =~ ^[A-Za-z0-9-]+$ ]] || fail "Invalid App Store locale in $localizations_file: $locale"
    locale_dir="$PROJECT_DIR/store-metadata/$locale"
    mkdir -p "$locale_dir"

    # Keep the Fastlane directory in sync with the JSON source. These are the
    # six version/app-info fields Apple permits Deliver to localize.
    for json_field in name description keywords releaseNotes; do
      case "$json_field" in
        releaseNotes) metadata_file=release_notes.txt ;;
        *) metadata_file="$json_field.txt" ;;
      esac
      value="$(jq -er --arg locale "$locale" --arg field "$json_field" '.[$locale].appInformation[$field] | if type == "string" and length > 0 then . else error("missing required localized field") end' "$localizations_file")" \
        || fail "Missing or empty $json_field for locale $locale in $localizations_file"
      printf '%s\n' "$value" > "$locale_dir/$metadata_file"
    done

    for json_field in subtitle promotionalText; do
      case "$json_field" in
        promotionalText) metadata_file=promotional_text.txt ;;
        *) metadata_file=subtitle.txt ;;
      esac
      if jq -e --arg locale "$locale" --arg field "$json_field" '.[$locale].appInformation[$field] | type == "string" and length > 0' "$localizations_file" >/dev/null; then
        jq -r --arg locale "$locale" --arg field "$json_field" '.[$locale].appInformation[$field]' "$localizations_file" > "$locale_dir/$metadata_file"
      else
        rm -f "$locale_dir/$metadata_file"
      fi
    done

    # App Store Connect requires a support URL for each localized app-info
    # record. Use the configured default unless a future localization-specific
    # support URL is introduced.
    printf '%s\n' "$SUPPORT_URL" > "$locale_dir/support_url.txt"
  done < <(jq -r 'keys[]' "$localizations_file")
  printf 'Staged localized App Store metadata from %s.\n' "$localizations_file"
}

stage_json_metadata_localizations

metadata_dir="$PROJECT_DIR/store-metadata/en-US"
mkdir -p "$metadata_dir"
write_metadata() { printf '%s\n' "$2" > "$metadata_dir/$1"; }
write_metadata name.txt "$APP_NAME"
write_metadata description.txt "$DESCRIPTION"
write_metadata keywords.txt "$KEYWORDS"
write_metadata release_notes.txt "$RELEASE_NOTES"
write_metadata support_url.txt "$SUPPORT_URL"
write_metadata privacy_url.txt "$PRIVACY_URL"
write_metadata copyright.txt "$COPYRIGHT"
age_rating_config="$metadata_dir/age_rating.json"
cat > "$age_rating_config" <<EOF
{
  "alcoholTobaccoOrDrugUseOrReferences": "${AGE_RATING_ALCOHOL_TOBACCO_OR_DRUG_USE_OR_REFERENCES:-NONE}",
  "contests": "${AGE_RATING_CONTESTS:-NONE}",
  "gamblingSimulated": "${AGE_RATING_GAMBLING_SIMULATED:-NONE}",
  "gunsOrOtherWeapons": "${AGE_RATING_GUNS_OR_OTHER_WEAPONS:-NONE}",
  "horrorOrFearThemes": "${AGE_RATING_HORROR_OR_FEAR_THEMES:-NONE}",
  "matureOrSuggestiveThemes": "${AGE_RATING_MATURE_OR_SUGGESTIVE_THEMES:-NONE}",
  "medicalOrTreatmentInformation": "${AGE_RATING_MEDICAL_OR_TREATMENT_INFORMATION:-NONE}",
  "profanityOrCrudeHumor": "${AGE_RATING_PROFANITY_OR_CRUDE_HUMOR:-NONE}",
  "sexualContentGraphicAndNudity": "${AGE_RATING_SEXUAL_CONTENT_GRAPHIC_AND_NUDITY:-NONE}",
  "sexualContentOrNudity": "${AGE_RATING_SEXUAL_CONTENT_OR_NUDITY:-NONE}",
  "violenceCartoonOrFantasy": "${AGE_RATING_VIOLENCE_CARTOON_OR_FANTASY:-NONE}",
  "violenceRealisticProlongedGraphicOrSadistic": "${AGE_RATING_VIOLENCE_REALISTIC_PROLONGED_GRAPHIC_OR_SADISTIC:-NONE}",
  "violenceRealistic": "${AGE_RATING_VIOLENCE_REALISTIC:-NONE}",
  "advertising": ${AGE_RATING_ADVERTISING:-0},
  "ageAssurance": ${AGE_RATING_AGE_ASSURANCE:-0},
  "gambling": ${AGE_RATING_GAMBLING:-0},
  "healthOrWellnessTopics": ${AGE_RATING_HEALTH_OR_WELLNESS_TOPICS:-0},
  "lootBox": ${AGE_RATING_LOOT_BOX:-0},
  "messagingAndChat": ${AGE_RATING_MESSAGING_AND_CHAT:-0},
  "parentalControls": ${AGE_RATING_PARENTAL_CONTROLS:-0},
  "socialMedia": ${AGE_RATING_SOCIAL_MEDIA:-0},
  "socialMediaAgeRestricted": ${AGE_RATING_SOCIAL_MEDIA_AGE_RESTRICTED:-0},
  "unrestrictedWebAccess": ${AGE_RATING_UNRESTRICTED_WEB_ACCESS:-0},
  "userGeneratedContent": ${AGE_RATING_USER_GENERATED_CONTENT:-0}
