# Copy this file to <app-project>/.deploy-app.env. Never commit the copy.
# Values must be accurate for the actual app and its legal/review declarations.
APP_IDENTIFIER=com.example.myapp
APP_NAME="My App"
APP_SKU=my-app-ios
SCHEME=MyApp
XCODEPROJ=MyApp.xcodeproj

# App Store Connect API key used by the submission script.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILE=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# Required for initial App Store Connect record creation.
APPLE_ID=
FASTLANE_SESSION=

# App Review contact information.
REVIEW_CONTACT_FIRST_NAME=
REVIEW_CONTACT_LAST_NAME=
REVIEW_CONTACT_PHONE=
REVIEW_CONTACT_EMAIL=
REVIEW_NOTES="No sign-in is required to use the app."

# Required first-release App Store metadata.
PRIMARY_CATEGORY=Education
COPYRIGHT="2026 Your Company"
SUPPORT_URL=https://example.com/support
PRIVACY_URL=https://example.com/privacy
SUBTITLE=
DESCRIPTION=
KEYWORDS=
PROMOTIONAL_TEXT=
RELEASE_NOTES="Initial release."

# Answer these truthfully. These declarations cannot be inferred from code.
# CONTENT_RIGHTS_DECLARATION: owns or third-party
CONTENT_RIGHTS_DECLARATION=owns
# Does the app (or included SDKs) use the advertising identifier?
USES_IDFA=0
# Does the app use non-exempt encryption?
USES_NON_EXEMPT_ENCRYPTION=0

# Optional build and asset settings. Screenshots must use only the highest
# required sizes: iPhone 6.9-inch (1260x2736, 1290x2796, or 1320x2868) and
# iPad 13-inch (2064x2752 or 2048x2732), in either orientation. Apple scales
# these screenshots for lower device sizes.
SCREENSHOT_PATHS="screenshots/iphone screenshots/ipad"
# App Previews are optional. Name iPhone files with IPHONE_67 and export at
# 886x1920 (or landscape equivalent); name iPad files with IPAD_PRO_3GEN_129
# and export at 1200x1600 (or landscape equivalent). Use 15-30 second H.264
# or ProRes files, with no more than 3 previews per device family.
PREVIEW_PATH=previews
RUN_TESTS=1
TEST_DEVICE="iPhone 17 Pro Max"
SKIP_BUILD_NUMBER_BUMP=0
AUTOMATIC_RELEASE=0

# Change this for every new App Store version. It identifies a resumable release.
RELEASE_VERSION=1.0.0
