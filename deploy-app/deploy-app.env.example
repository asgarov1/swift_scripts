# Copy this file to <app-project>/.deploy-app.env. Never commit the copy.
# Values must be accurate for the actual app and its legal/review declarations.
APP_IDENTIFIER=com.example.myapp
APP_NAME="My App"
APP_SKU=my-app-ios
SCHEME=MyApp
XCODEPROJ=MyApp.xcodeproj

# App Store Connect API key used by the submission script.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_FILE=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
# Do not add APPLE_ID or FASTLANE_SESSION. Deployment uses only the App Store
# Connect API key and deliberately never invokes Fastlane's Apple ID web login.

REVIEW_CONTACT_FIRST_NAME=
REVIEW_CONTACT_LAST_NAME=
REVIEW_CONTACT_PHONE=
REVIEW_CONTACT_EMAIL=
REVIEW_NOTES="No sign-in is required to use the app."

PRIMARY_CATEGORY=Education
COPYRIGHT="2026 Your Company"
SUPPORT_URL=https://example.com/support
LANGUAGE_NAME=Spanish
LANGUAGE_LEVEL=A1
PRIVACY_URL=https://asgarov1.github.io/Privacy-Policies/spanish_a1_privacy_policy
SUBTITLE=
DESCRIPTION=
KEYWORDS=
PROMOTIONAL_TEXT="No account, no registration, fully offline app - ideal for learning on the go!"
RELEASE_NOTES="Initial release."

PRIVACY_POLICY_SOURCE=PRIVACY_POLICY.md
PRIVACY_POLICIES_REPO=/Users/asgarov1/Projects/swift/Privacy-Policies
PRIVACY_POLICY_PUBLISHED_PATH=spanish_a1_privacy_policy.md

# Answer these truthfully. CONTENT_RIGHTS_DECLARATION: owns or third-party.
CONTENT_RIGHTS_DECLARATION=owns
PRICE_TIER=0
AVAILABLE_IN_ALL_TERRITORIES=1

# Default products created in App Store Connect with --create-app. Product IDs
# default to ${APP_IDENTIFIER}.premium, .premium.3months, and .premium.lifetime.
IAP_CREATE_DEFAULTS=1
IAP_SUBSCRIPTION_GROUP_NAME="Premium Access"
IAP_MONTHLY_REFERENCE_NAME="Monthly Subscription"
IAP_MONTHLY_PRODUCT_ID=
IAP_MONTHLY_PRICE_USD=6.99
IAP_QUARTERLY_REFERENCE_NAME="Quarterly (3 months) Subscription"
IAP_QUARTERLY_PRODUCT_ID=
IAP_QUARTERLY_PRICE_USD=14.99
IAP_LIFETIME_REFERENCE_NAME="Lifetime Access"
IAP_LIFETIME_PRODUCT_ID=
IAP_LIFETIME_PRICE_USD=44.99
USES_IDFA=0
USES_NON_EXEMPT_ENCRYPTION=0

# Complete these truthfully for your app.
AGE_RATING_ALCOHOL_TOBACCO_OR_DRUG_USE_OR_REFERENCES=NONE
AGE_RATING_CONTESTS=NONE
AGE_RATING_GAMBLING_SIMULATED=NONE
AGE_RATING_GUNS_OR_OTHER_WEAPONS=NONE
AGE_RATING_HORROR_OR_FEAR_THEMES=NONE
AGE_RATING_MATURE_OR_SUGGESTIVE_THEMES=NONE
AGE_RATING_MEDICAL_OR_TREATMENT_INFORMATION=NONE
AGE_RATING_PROFANITY_OR_CRUDE_HUMOR=NONE
AGE_RATING_SEXUAL_CONTENT_GRAPHIC_AND_NUDITY=NONE
AGE_RATING_SEXUAL_CONTENT_OR_NUDITY=NONE
AGE_RATING_VIOLENCE_CARTOON_OR_FANTASY=NONE
AGE_RATING_VIOLENCE_REALISTIC_PROLONGED_GRAPHIC_OR_SADISTIC=NONE
AGE_RATING_VIOLENCE_REALISTIC=NONE
AGE_RATING_ADVERTISING=0
AGE_RATING_AGE_ASSURANCE=0
AGE_RATING_GAMBLING=0
AGE_RATING_HEALTH_OR_WELLNESS_TOPICS=0
AGE_RATING_LOOT_BOX=0
AGE_RATING_MESSAGING_AND_CHAT=0
AGE_RATING_PARENTAL_CONTROLS=0
AGE_RATING_SOCIAL_MEDIA=0
AGE_RATING_SOCIAL_MEDIA_AGE_RESTRICTED=0
AGE_RATING_UNRESTRICTED_WEB_ACCESS=0
AGE_RATING_USER_GENERATED_CONTENT=0

# Screenshots must use Apple’s highest required iPhone 6.9-inch and iPad
# 13-inch dimensions. Exact already-complete screenshots are skipped on retry.
SCREENSHOT_PATHS="screenshots/iphone screenshots/ipad"
SKIP_SCREENSHOTS_IF_UNCHANGED=1
PREVIEW_PATH=previews
RUN_TESTS=1
TEST_DEVICE="iPhone 17 Pro Max"
BUILD_NUMBER=1
AUTOMATIC_RELEASE=0
RELEASE_VERSION=1.0.0
